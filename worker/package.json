{
  "name": "dear-lottery-worker",
  "version": "1.0.0",
  "description": "Serverless edge backend, D1 SQLite database and API for Dear Lottery Engine",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute dear_lottery_db --local --file=src/db/schema.sql",
    "d1:init:prod": "wrangler d1 execute dear_lottery_db --remote --file=src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "typescript": "^5.6.2",
    "wrangler": "3.114.17"
  }
}
