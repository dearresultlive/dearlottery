---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  drawDate?: string;
  drawTime?: string;
  winningNumbers?: {
    firstPrize?: string;
    secondPrize?: string[];
  };
}

const { title, description, drawDate, drawTime, winningNumbers } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="bn" data-lang="bn" translate="no" class="notranslate scroll-smooth bg-slate-100 text-slate-900 antialiased">
  <SEOHead
    title={title}
    description={description}
    drawDate={drawDate}
    drawTime={drawTime}
    winningNumbers={winningNumbers}
  />
  <script is:inline>
    try {
      var savedLang = localStorage.getItem('dearlottery_lang');
      if (savedLang === 'en') {
        document.documentElement.lang = 'en';
        document.documentElement.setAttribute('data-lang', 'en');
      } else {
        document.documentElement.lang = 'bn';
        document.documentElement.setAttribute('data-lang', 'bn');
      }
    } catch (e) {}
  </script>
  <body class="notranslate min-h-screen flex flex-col font-sans bg-slate-100 text-slate-900 selection:bg-amber-400 selection:text-slate-950">
    <Header currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
