---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PwaInstallBanner from '../components/PwaInstallBanner';

interface Props {
  title?: string;
  description?: string;
  drawDate?: string;
  drawTime?: string;
  winningNumbers?: {
    firstPrize?: string;
    secondPrize?: string[];
  };
  faqItems?: Array<{
    question: string;
    answer: string;
  }>;
}

const { title, description, drawDate, drawTime, winningNumbers, faqItems } = Astro.props;
const currentPath = Astro.url.pathname;
const isHomeActive = currentPath === '/' || (currentPath.startsWith('/results') && !currentPath.includes('yesterday'));
const isLuckyActive = currentPath === '/lucky-ticket' || currentPath === '/demo';
const isTargetsActive = currentPath === '/target-numbers';
const isCheckerActive = currentPath === '/checker';
const isMoreActive = currentPath === '/analytics' || currentPath === '/yesterday' || currentPath === '/old-results' || currentPath === '/disclaimer' || currentPath === '/terms' || currentPath === '/contact';
---

<!doctype html>
<html lang="en" data-lang="en" translate="no" class="notranslate scroll-smooth bg-slate-100 text-slate-900 antialiased">
  <SEOHead
    title={title}
    description={description}
    drawDate={drawDate}
    drawTime={drawTime}
    winningNumbers={winningNumbers}
    faqItems={faqItems}
  />
  <script is:inline>
    try {
      var savedLang = localStorage.getItem('dearlottery_lang');
      if (savedLang === 'bn' || savedLang === 'hi' || savedLang === 'en') {
        document.documentElement.setAttribute('data-lang', savedLang);
      } else {
        document.documentElement.setAttribute('data-lang', 'en');
      }
    } catch (e) {}

    window.addEventListener('dearlottery:lang_change', function(e) {
      if (e.detail) {
        document.documentElement.setAttribute('data-lang', e.detail);
      }
    });

    // Instant notification pre-paint check: suppresses 1s bell icon flicker on page refresh
    try {
      if (typeof window !== 'undefined' && 'Notification' in window && Notification.permission === 'granted') {
        document.documentElement.classList.add('notifications-granted');
      }
    } catch (e) {}

    // Global early capture of PWA beforeinstallprompt event for instant 1-tap install
    window.deferredPwaPrompt = null;
    window.addEventListener('beforeinstallprompt', function(e) {
      e.preventDefault();
      window.deferredPwaPrompt = e;
      window.dispatchEvent(new CustomEvent('dearlottery:pwa_ready'));
    });

    window.addEventListener('appinstalled', function() {
      window.deferredPwaPrompt = null;
      var btn = document.getElementById('header-install-app-btn');
      if (btn) btn.style.display = 'none';
      var modal = document.getElementById('pwa-install-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    // Register PWA service worker with offline fallback & push support
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
      });
    }
  </script>

  <style is:global>
    /* Suppress Google Translate Banners & Tooltips */
    .goog-te-banner-frame,
    .skiptranslate,
    #goog-gt-tt,
    .goog-te-balloon-frame {
      display: none !important;
    }
    body {
      top: 0px !important;
    }

    /* Instant CSS Multilingual Switching (English default, Bengali, Hindi) */
    html:not([data-lang="bn"]):not([data-lang="hi"]) .lang-bn,
    html:not([data-lang="bn"]):not([data-lang="hi"]) .lang-hi {
      display: none !important;
    }

    html[data-lang="en"] .lang-bn,
    html[data-lang="en"] .lang-hi {
      display: none !important;
    }

    html[data-lang="bn"] .lang-en,
    html[data-lang="bn"] .lang-hi {
      display: none !important;
    }

    html[data-lang="hi"] .lang-en,
    html[data-lang="hi"] .lang-bn {
      display: none !important;
    }

    /* Instantly hide notification bell for already subscribed users (0ms flicker prevention) */
    html.notifications-granted #header-bell-wrapper,
    html.notifications-granted #header-notification-bell,
    html.notifications-granted .header-notification-bell-wrapper {
      display: none !important;
    }
  </style>
  <body class="notranslate min-h-screen flex flex-col font-sans bg-slate-100 text-slate-900 selection:bg-amber-400 selection:text-slate-950" translate="no">
    <Header currentPath={currentPath} />
    <main class="flex-1 notranslate pb-24 md:pb-0" translate="no">
      <slot />
    </main>
    <Footer />
    
    {/* PWA Floating Bottom Install Banner (Available on all pages) */}
    <PwaInstallBanner client:idle />

    {/* Mobile Sticky Bottom Navigation Dock (5-Tab Standard Mobile Ergonomics) */}
    <nav aria-label="Mobile Quick Dock" style="padding-bottom: max(0.4rem, env(safe-area-inset-bottom));" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] px-1 pt-1.5 flex items-center justify-around text-center select-none notranslate" translate="no">
      <a
        href="/"
        aria-label="Today Live Results"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isHomeActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-base sm:text-lg">☀️</span>
        <span class="text-[10px] mt-0.5 leading-tight">
          <span class="lang-en">Today</span>
          <span class="lang-bn">আজকের</span>
          <span class="lang-hi">आज</span>
        </span>
      </a>

      <a
        href="/lucky-ticket"
        aria-label="Lucky Ticket Simulator"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isLuckyActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-base sm:text-lg">🎟️</span>
        <span class="text-[10px] mt-0.5 leading-tight">
          <span class="lang-en">Lucky</span>
          <span class="lang-bn">লাকি</span>
          <span class="lang-hi">लकी</span>
        </span>
      </a>

      <a
        href="/target-numbers"
        aria-label="Target and Hot Numbers"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isTargetsActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-base sm:text-lg">🎯</span>
        <span class="text-[10px] mt-0.5 leading-tight">
          <span class="lang-en">Targets</span>
          <span class="lang-bn">টার্গেট</span>
          <span class="lang-hi">टारगेट</span>
        </span>
      </a>

      <a
        href="/checker"
        aria-label="Check Lottery Ticket"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isCheckerActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-base sm:text-lg">🔍</span>
        <span class="text-[10px] mt-0.5 leading-tight">
          <span class="lang-en">Checker</span>
          <span class="lang-bn">চেকার</span>
          <span class="lang-hi">चेकर</span>
        </span>
      </a>

      <button
        type="button"
        id="mobile-more-btn"
        aria-label="Open More Features Menu"
        aria-expanded="false"
        aria-controls="mobile-more-sheet"
        onclick="window.toggleMobileMoreMenu && window.toggleMobileMoreMenu()"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 cursor-pointer ${
          isMoreActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-base sm:text-lg">☰</span>
        <span class="text-[10px] mt-0.5 leading-tight">
          <span class="lang-en">More</span>
          <span class="lang-bn">আরও</span>
          <span class="lang-hi">और</span>
        </span>
      </button>
    </nav>

    {/* Mobile "More" Bottom Sheet Modal & Backdrop */}
    <div
      id="mobile-more-sheet-backdrop"
      class="md:hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden opacity-0 transition-opacity duration-200"
      onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()"
      aria-hidden="true"
    ></div>

    <div
      id="mobile-more-sheet"
      class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white rounded-t-3xl shadow-[0_-8px_30px_rgba(0,0,0,0.18)] border-t border-slate-200 max-w-lg mx-auto transform translate-y-full transition-transform duration-300 ease-out flex flex-col max-h-[85vh] notranslate"
      role="dialog"
      aria-modal="true"
      aria-label="More Features & Menu"
      style="padding-bottom: max(1.2rem, env(safe-area-inset-bottom));"
    >
      {/* Drag Handle Indicator */}
      <div class="pt-3 pb-1 cursor-pointer" onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()">
        <div class="w-12 h-1.5 bg-slate-300 rounded-full mx-auto"></div>
      </div>

      {/* Header */}
      <div class="px-5 py-2.5 flex items-center justify-between border-b border-slate-100">
        <div class="flex items-center gap-2">
          <span class="text-lg">📋</span>
          <h3 class="font-black text-sm text-slate-900 tracking-tight">
            <span class="lang-en">Menu & Features</span>
            <span class="lang-bn">মেনু ও অন্যান্য ফিচার</span>
            <span class="lang-hi">मेनू और सभी फीचर्स</span>
          </h3>
        </div>
        <button
          type="button"
          onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center text-sm font-bold transition-colors cursor-pointer"
          aria-label="Close Menu"
        >
          ✕
        </button>
      </div>

      {/* Scrollable Sheet Content */}
      <div class="p-3.5 space-y-2 overflow-y-auto">
        {/* Featured Item: 5Y Analytics */}
        <a
          href="/analytics"
          onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()"
          class={`flex items-center justify-between p-3 rounded-2xl border transition-all ${
            currentPath === '/analytics'
              ? 'bg-blue-50/90 border-blue-400 shadow-xs'
              : 'bg-gradient-to-r from-blue-50/70 to-indigo-50/40 border-blue-200 hover:border-blue-300'
          }`}
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center text-lg shadow-sm flex-shrink-0">
              📊
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="font-black text-sm text-slate-900">
                  <span class="lang-en">5Y Digit Analytics</span>
                  <span class="lang-bn">৫ বছরের ডিজিট অ্যানালিটিক্স</span>
                  <span class="lang-hi">5-वर्षीय डिजिट एनालिटिक्स</span>
                </span>
                <span class="bg-blue-600 text-white font-black text-[9px] px-1.5 py-0.2 rounded-full uppercase tracking-wider">
                  HOT
                </span>
              </div>
              <span class="text-[11px] text-slate-600 block mt-0.5">
                <span class="lang-en">5-year digit frequency, hot & cold numbers</span>
                <span class="lang-bn">হট/কোল্ড নম্বর ও ৫ বছরের ফ্রিকোয়েন্সি</span>
                <span class="lang-hi">हॉट व कोल्ड नंबर और 5-वर्षीय ट्रेंड्स</span>
              </span>
            </div>
          </div>
          <span class="text-blue-600 font-black text-sm ml-2">➔</span>
        </a>

        {/* Yesterday's Results */}
        <a
          href="/yesterday"
          onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()"
          class={`flex items-center justify-between p-3 rounded-2xl border transition-all ${
            currentPath === '/yesterday'
              ? 'bg-amber-50 border-amber-400 shadow-xs'
              : 'bg-white border-slate-200 hover:border-slate-300'
          }`}
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-lg shadow-sm flex-shrink-0">
              📜
            </div>
            <div>
              <span class="font-black text-sm text-slate-900 block">
                <span class="lang-en">Yesterday's Results</span>
                <span class="lang-bn">গতকালকের ফলাফল</span>
                <span class="lang-hi">कल का रिजल्ट</span>
              </span>
              <span class="text-[11px] text-slate-600 block mt-0.5">
                <span class="lang-en">1PM, 6PM & 8PM official winning sheets</span>
                <span class="lang-bn">১PM, ৬PM ও ৮PM গেজেট রেজাল্ট</span>
                <span class="lang-hi">1PM, 6PM और 8PM रिजल्ट शीट</span>
              </span>
            </div>
          </div>
          <span class="text-slate-400 font-bold text-sm ml-2">➔</span>
        </a>

        {/* Old Results 30 Days */}
        <a
          href="/old-results"
          onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()"
          class={`flex items-center justify-between p-3 rounded-2xl border transition-all ${
            currentPath === '/old-results'
              ? 'bg-emerald-50 border-emerald-400 shadow-xs'
              : 'bg-white border-slate-200 hover:border-slate-300'
          }`}
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-lg shadow-sm flex-shrink-0">
              📅
            </div>
            <div>
              <span class="font-black text-sm text-slate-900 block">
                <span class="lang-en">Old Results (30 Days)</span>
                <span class="lang-bn">পুরনো রেজাল্ট আর্কাইভ</span>
                <span class="lang-hi">पुराने नतीजे (30 दिन)</span>
              </span>
              <span class="text-[11px] text-slate-600 block mt-0.5">
                <span class="lang-en">Download official state gazette PDFs</span>
                <span class="lang-bn">গত ৩০ দিনের সমস্ত লটারি শিট ও গেজেট</span>
                <span class="lang-hi">पिछले 30 दिनों के सभी ड्रॉ रिकॉर्ड</span>
              </span>
            </div>
          </div>
          <span class="text-slate-400 font-bold text-sm ml-2">➔</span>
        </a>

        {/* Quick App Install Trigger */}
        <button
          type="button"
          onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu(); window.triggerPwaInstall && window.triggerPwaInstall();"
          class="w-full flex items-center justify-between p-3 rounded-2xl border border-amber-300 bg-gradient-to-r from-amber-50 to-orange-50 text-left transition-all active:scale-[0.99] cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center text-lg shadow-sm flex-shrink-0">
              📲
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="font-black text-sm text-slate-900">
                  <span class="lang-en">Install Mobile App</span>
                  <span class="lang-bn">মোবাইল অ্যাপ ইনস্টল</span>
                  <span class="lang-hi">मोबाइल ऐप इंस्टॉल</span>
                </span>
                <span class="bg-amber-400 text-slate-950 font-black text-[9px] px-1.5 py-0.2 rounded-full uppercase">
                  FAST
                </span>
              </div>
              <span class="text-[11px] text-slate-600 block mt-0.5">
                <span class="lang-en">Ad-free, 1-tap instant draws on home screen</span>
                <span class="lang-bn">বিজ্ঞাপনহীন, হোম স্ক্রিনে সরাসরি রেজাল্ট</span>
                <span class="lang-hi">बिना विज्ञापन, 1-टैप में सीधा परिणाम</span>
              </span>
            </div>
          </div>
          <span class="text-amber-700 font-black text-sm ml-2">➔</span>
        </button>

        {/* Bottom Secondary Links (Disclaimer, Terms, Contact) */}
        <div class="pt-3 border-t border-slate-100 flex items-center justify-around text-xs text-slate-500 font-medium">
          <a href="/disclaimer" onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()" class="hover:text-blue-700 py-1 px-2">
            <span class="lang-en">Disclaimer</span>
            <span class="lang-bn">দাবিত্যাগ</span>
            <span class="lang-hi">अस्वीकरण</span>
          </a>
          <span>•</span>
          <a href="/terms" onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()" class="hover:text-blue-700 py-1 px-2">
            <span class="lang-en">Terms</span>
            <span class="lang-bn">শর্তাবলী</span>
            <span class="lang-hi">शर्तें</span>
          </a>
          <span>•</span>
          <a href="/contact" onclick="window.closeMobileMoreMenu && window.closeMobileMoreMenu()" class="hover:text-blue-700 py-1 px-2">
            <span class="lang-en">Contact</span>
            <span class="lang-bn">যোগাযোগ</span>
            <span class="lang-hi">संपर्क</span>
          </a>
        </div>
      </div>
    </div>

    {/* PWA Install Guidance Modal for Mobile & Desktop */}
    <div
      id="pwa-install-modal"
      class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs hidden items-center justify-center p-3.5 sm:p-4 select-none notranslate"
      onclick="if (event.target === this) { this.classList.add('hidden'); this.classList.remove('flex'); }"
      role="dialog"
      aria-modal="true"
      aria-label="Install App"
    >
      <div class="bg-gradient-to-b from-slate-900 to-slate-950 text-white w-full max-w-sm rounded-2xl p-5 shadow-2xl border border-amber-400/40 relative overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        
        {/* Subtle decorative glow */}
        <div class="absolute -top-12 -right-12 w-28 h-28 bg-amber-400/20 rounded-full blur-2xl pointer-events-none"></div>

        {/* Modal Header */}
        <div class="flex items-start justify-between gap-3 relative z-10 pb-3 border-b border-white/10">
          <div class="flex items-center gap-2.5">
            <img
              src="/pwa-192x192.png"
              alt="Dear Result Live Logo"
              class="w-11 h-11 rounded-xl shadow-md border border-amber-300/40 p-0.5 bg-slate-900 flex-shrink-0"
            />
            <div>
              <div class="flex items-center gap-1.5">
                <h3 class="font-black text-sm tracking-tight text-white">
                  <span class="lang-en">Dear Result Live App</span>
                  <span class="lang-bn">ডিয়ার রেজাল্ট লাইভ অ্যাপ</span>
                  <span class="lang-hi">डियर रिजल्ट लाइव ऐप</span>
                </h3>
                <span class="bg-amber-400 text-slate-950 font-black text-[9px] px-1.5 py-0.2 rounded-full uppercase">
                  PWA
                </span>
              </div>
              <p class="text-[11px] text-blue-200 font-semibold mt-0.5">
                <span class="lang-en">Fast • Ad-Free • 1-Tap Results</span>
                <span class="lang-bn">দ্রুততম • বিজ্ঞাপনহীন • ১-ট্যাপে রেজাল্ট</span>
                <span class="lang-hi">सबसे तेज़ • विज्ञापनमुक्त • 1-टैप रिजल्ट</span>
              </p>
            </div>
          </div>

          <button
            type="button"
            onclick="document.getElementById('pwa-install-modal').classList.add('hidden'); document.getElementById('pwa-install-modal').classList.remove('flex');"
            class="text-white/60 hover:text-white p-1 rounded-lg transition-colors text-base font-bold leading-none cursor-pointer"
            aria-label="Close"
          >
            ✕
          </button>
        </div>

        {/* Modal Body / Guided Instructions */}
        <div class="py-4 space-y-3 relative z-10">
          {/* iOS Safari Guide */}
          <div id="pwa-guide-ios" class="space-y-2 text-xs text-slate-200">
            <p class="font-bold text-amber-300 text-xs flex items-center gap-1">
              <span>🍏</span>
              <span class="lang-en">iPhone / iPad Safari Install:</span>
              <span class="lang-bn">আইফোন / আইপ্যাডে ইনস্টল করুন:</span>
              <span class="lang-hi">iPhone / iPad में इंस्टॉल करें:</span>
            </p>
            <ol class="space-y-2 pl-1 text-[11px] text-slate-300">
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-blue-600/50 text-blue-200 font-black flex items-center justify-center flex-shrink-0 text-[10px]">1</span>
                <div>
                  <span class="lang-en">Tap the <strong>Share</strong> button (⎋) at bottom of Safari.</span>
                  <span class="lang-bn">Safari-র নিচে থাকা <strong>Share (⎋)</strong> বাটনে ট্যাপ করুন।</span>
                  <span class="lang-hi">Safari में नीचे <strong>Share (⎋)</strong> बटन दबाएं।</span>
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-blue-600/50 text-blue-200 font-black flex items-center justify-center flex-shrink-0 text-[10px]">2</span>
                <div>
                  <span class="lang-en">Scroll down and tap <strong>"Add to Home Screen" (+)</strong>.</span>
                  <span class="lang-bn">নিচে স্ক্রোল করে <strong>"Add to Home Screen" (+)</strong> চাপুন।</span>
                  <span class="lang-hi">नीचे जाकर <strong>"Add to Home Screen" (+)</strong> चुनें।</span>
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-blue-600/50 text-blue-200 font-black flex items-center justify-center flex-shrink-0 text-[10px]">3</span>
                <div>
                  <span class="lang-en">Tap <strong>"Add"</strong> at top-right. App is ready!</span>
                  <span class="lang-bn">উপরে ডানদিকে <strong>"Add"</strong> বাটনে ক্লিক করলেই তৈরি!</span>
                  <span class="lang-hi">ऊपर दाईं तरफ <strong>"Add"</strong> दबाएं।</span>
                </div>
              </li>
            </ol>
          </div>

          {/* Android / Chrome Guide */}
          <div id="pwa-guide-android" class="space-y-2 text-xs text-slate-200">
            <p class="font-bold text-amber-300 text-xs flex items-center gap-1">
              <span>📲</span>
              <span class="lang-en">Android / Chrome 1-Click Install:</span>
              <span class="lang-bn">অ্যান্ড্রয়েড / ক্রোমে ইনস্টল করার নিয়ম:</span>
              <span class="lang-hi">Android / Chrome में इंस्टॉल करने का तरीका:</span>
            </p>
            <ol class="space-y-2 pl-1 text-[11px] text-slate-300">
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-amber-500/30 text-amber-300 font-black flex items-center justify-center flex-shrink-0 text-[10px]">1</span>
                <div>
                  <span class="lang-en">Tap the <strong>3-dots menu (⋮)</strong> at top-right of browser.</span>
                  <span class="lang-bn">ব্রাউজারের উপরের ডানদিকের <strong>৩-ডট মেনুতে (⋮)</strong> চাপুন।</span>
                  <span class="lang-hi">ब्राउज़र के ऊपर दाईं ओर <strong>3-डॉट मेनू (⋮)</strong> पर दबाएं।</span>
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-amber-500/30 text-amber-300 font-black flex items-center justify-center flex-shrink-0 text-[10px]">2</span>
                <div>
                  <span class="lang-en">Select <strong>"Install app"</strong> or <strong>"Add to Home screen"</strong>.</span>
                  <span class="lang-bn"><strong>"Install app"</strong> অথবা <strong>"Add to Home screen"</strong> চাপুন।</span>
                  <span class="lang-hi"><strong>"Install app"</strong> या <strong>"Add to Home screen"</strong> चुनें।</span>
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-amber-500/30 text-amber-300 font-black flex items-center justify-center flex-shrink-0 text-[10px]">3</span>
                <div>
                  <span class="lang-en">Tap <strong>"Install"</strong> to add the app icon to your phone!</span>
                  <span class="lang-bn"><strong>"Install"</strong> চাপলেই ফোনের হোম স্ক্রিনে অ্যাপ যুক্ত হয়ে যাবে!</span>
                  <span class="lang-hi"><strong>"Install"</strong> दबाते ही फोन में ऐप आ जाएगा!</span>
                </div>
              </li>
            </ol>
          </div>
        </div>

        {/* Modal Action Buttons */}
        <div class="pt-3 border-t border-white/10 flex items-center gap-2">
          <button
            id="pwa-modal-action-btn"
            type="button"
            onclick="if (window.deferredPwaPrompt) { window.deferredPwaPrompt.prompt(); } document.getElementById('pwa-install-modal').classList.add('hidden'); document.getElementById('pwa-install-modal').classList.remove('flex');"
            class="flex-1 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-xs py-2.5 px-3 rounded-xl shadow-md transition-all active:scale-95 text-center cursor-pointer"
          >
            <span class="lang-en">Install / OK</span>
            <span class="lang-bn">ইনস্টল / বুঝেছি</span>
            <span class="lang-hi">इंस्टॉल / समझ गया</span>
          </button>
        </div>

      </div>
    </div>

    <script is:inline>
      (function() {
        // Mobile "More" Bottom Sheet Controller
        window.toggleMobileMoreMenu = function() {
          var sheet = document.getElementById('mobile-more-sheet');
          var backdrop = document.getElementById('mobile-more-sheet-backdrop');
          var btn = document.getElementById('mobile-more-btn');
          if (!sheet || !backdrop) return;
          var isOpen = !sheet.classList.contains('translate-y-full');
          if (isOpen) {
            window.closeMobileMoreMenu();
          } else {
            backdrop.classList.remove('hidden');
            void backdrop.offsetWidth;
            backdrop.classList.remove('opacity-0');
            sheet.classList.remove('translate-y-full');
            sheet.classList.add('translate-y-0');
            if (btn) btn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
          }
        };

        window.closeMobileMoreMenu = function() {
          var sheet = document.getElementById('mobile-more-sheet');
          var backdrop = document.getElementById('mobile-more-sheet-backdrop');
          var btn = document.getElementById('mobile-more-btn');
          if (!sheet || !backdrop) return;
          sheet.classList.remove('translate-y-0');
          sheet.classList.add('translate-y-full');
          backdrop.classList.add('opacity-0');
          setTimeout(function() {
            backdrop.classList.add('hidden');
          }, 220);
          if (btn) btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            window.closeMobileMoreMenu();
          }
        });

        function checkPlatform() {
          var ua = navigator.userAgent || '';
          var isIOS = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
          var iosGuide = document.getElementById('pwa-guide-ios');
          var androidGuide = document.getElementById('pwa-guide-android');
          if (isIOS) {
            if (iosGuide) iosGuide.style.display = 'block';
            if (androidGuide) androidGuide.style.display = 'none';
          } else {
            if (iosGuide) iosGuide.style.display = 'none';
            if (androidGuide) androidGuide.style.display = 'block';
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', checkPlatform);
        } else {
          checkPlatform();
        }
      })();
    </script>
  </body>
</html>
