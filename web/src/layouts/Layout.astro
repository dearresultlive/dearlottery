---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  drawDate?: string;
  drawTime?: string;
  winningNumbers?: {
    firstPrize?: string;
    secondPrize?: string[];
  };
}

const { title, description, drawDate, drawTime, winningNumbers } = Astro.props;
const currentPath = Astro.url.pathname;
const isHomeActive = currentPath === '/' || currentPath.startsWith('/results');
const isDemoActive = currentPath === '/demo';
const isTargetsActive = currentPath === '/target-numbers' || currentPath === '/analytics';
const isCheckerActive = currentPath === '/checker';
---

<!doctype html>
<html lang="en" data-lang="en" translate="no" class="notranslate scroll-smooth bg-slate-100 text-slate-900 antialiased">
  <SEOHead
    title={title}
    description={description}
    drawDate={drawDate}
    drawTime={drawTime}
    winningNumbers={winningNumbers}
  />
  <script is:inline>
    try {
      var savedLang = localStorage.getItem('dearlottery_lang');
      if (savedLang === 'bn' || savedLang === 'hi' || savedLang === 'en') {
        document.documentElement.setAttribute('data-lang', savedLang);
      } else {
        document.documentElement.setAttribute('data-lang', 'en');
      }
    } catch (e) {}

    window.addEventListener('dearlottery:lang_change', function(e) {
      if (e.detail) {
        document.documentElement.setAttribute('data-lang', e.detail);
      }
    });
  </script>

  <style is:global>
    /* Suppress Google Translate Banners & Tooltips */
    .goog-te-banner-frame,
    .skiptranslate,
    #goog-gt-tt,
    .goog-te-balloon-frame {
      display: none !important;
    }
    body {
      top: 0px !important;
    }

    /* Instant CSS Multilingual Switching (English default, Bengali, Hindi) */
    html:not([data-lang="bn"]):not([data-lang="hi"]) .lang-bn,
    html:not([data-lang="bn"]):not([data-lang="hi"]) .lang-hi {
      display: none !important;
    }

    html[data-lang="en"] .lang-bn,
    html[data-lang="en"] .lang-hi {
      display: none !important;
    }

    html[data-lang="bn"] .lang-en,
    html[data-lang="bn"] .lang-hi {
      display: none !important;
    }

    html[data-lang="hi"] .lang-en,
    html[data-lang="hi"] .lang-bn {
      display: none !important;
    }
  </style>
  <body class="notranslate min-h-screen flex flex-col font-sans bg-slate-100 text-slate-900 selection:bg-amber-400 selection:text-slate-950" translate="no">
    <Header currentPath={currentPath} />
    <main class="flex-1 notranslate pb-24 md:pb-0" translate="no">
      <slot />
    </main>
    <Footer />

    {/* Mobile Sticky Bottom Navigation Dock (1-Thumb Mobile Ergonomics) */}
    <nav aria-label="Mobile Quick Dock" style="padding-bottom: max(0.4rem, env(safe-area-inset-bottom));" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] px-2 pt-1.5 flex items-center justify-around text-center select-none notranslate" translate="no">
      <a
        href="/"
        aria-label="Today Live Results"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isHomeActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-lg">☀️</span>
        <span class="text-[10px] mt-0.5">
          <span class="lang-en">Today</span>
          <span class="lang-bn">আজকের ড্র</span>
          <span class="lang-hi">आज का ड्रॉ</span>
        </span>
      </a>

      <a
        href="/demo"
        aria-label="Demo Lottery Paper Play"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isDemoActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-lg">🎮</span>
        <span class="text-[10px] mt-0.5">
          <span class="lang-en">Demo Play</span>
          <span class="lang-bn">ডেমো প্লে</span>
          <span class="lang-hi">डेमो प्ले</span>
        </span>
      </a>

      <a
        href="/target-numbers"
        aria-label="Target and Common Numbers"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isTargetsActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-lg">🎯</span>
        <span class="text-[10px] mt-0.5">
          <span class="lang-en">Targets</span>
          <span class="lang-bn">টার্গেট</span>
          <span class="lang-hi">टारगेट</span>
        </span>
      </a>

      <a
        href="/checker"
        aria-label="Check Lottery Ticket"
        class={`flex flex-col items-center justify-center flex-1 min-h-[48px] py-1 transition-all active:scale-95 ${
          isCheckerActive ? 'text-blue-700 font-black' : 'text-slate-600 font-semibold hover:text-slate-900'
        }`}
      >
        <span class="text-lg">🔍</span>
        <span class="text-[10px] mt-0.5">
          <span class="lang-en">Check Ticket</span>
          <span class="lang-bn">টিকিট মেলান</span>
          <span class="lang-hi">टिकट चेक</span>
        </span>
      </a>
    </nav>
  </body>
</html>
