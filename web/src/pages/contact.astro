---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us | Dear Result Live (যোগাযোগ)"
  description="Contact the editorial and support team at Dear Result Live for data corrections, technical inquiries, or regulatory feedback."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8 text-slate-300">
    
    <div class="border-b border-slate-800 pb-6">
      <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">Get In Touch</span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mt-1">
        Contact Us (যোগাযোগ)
      </h1>
      <p class="text-slate-400 text-sm mt-2">
        Have a question, feedback, or notice a data discrepancy? Reach out to our technical team.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl">
          ✉️
        </div>
        <h3 class="text-lg font-bold text-white">Editorial & Corrections</h3>
        <p class="text-slate-400 text-xs leading-relaxed">
          For reporting any OCR transcription errors, draw date mismatches, or gazette verification inquiries:
        </p>
        <p class="text-amber-400 font-mono font-bold">
          support@dearresultlive.in
        </p>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl">
          ⚖️
        </div>
        <h3 class="text-lg font-bold text-white">Legal & Compliance Notice</h3>
        <p class="text-slate-400 text-xs leading-relaxed">
          For official state lottery claim procedures, tickets and identity verification must be handled directly with the official Directorate of State Lotteries in Nagaland or Sikkim.
        </p>
      </div>
    </div>

  </div>
</Layout>
