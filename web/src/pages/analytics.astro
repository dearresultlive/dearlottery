---
import Layout from '../layouts/Layout.astro';
import AnalyticsModule from '../components/AnalyticsModule';
import { fetchFrequencyAnalytics } from '../lib/api';

const analytics = await fetchFrequencyAnalytics();
---

<Layout
  title="Dear Lottery Hot & Cold Numbers | 4-Digit Frequency & Digit Heatmap"
  description="Explore Dear Lottery Hot & Cold numbers, 4-digit repetition analysis, and positional digit frequency heatmaps across Nagaland & Sikkim State Lottery daily draws."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-8">
    <div class="text-center max-w-3xl mx-auto">
      <span class="bg-blue-50 border border-blue-200 text-blue-700 text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full">
        📊 নম্বর বিশ্লেষণ ও পরিসংখ্যান
      </span>
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mt-2">
        গত ৩০ দিনের হট ও কোল্ড নম্বর (বেশি আসা নম্বর)
      </h1>
      <p class="text-slate-600 text-xs sm:text-sm mt-1">
        সরকারি লটারি ড্র-এর ফলাফল থেকে তৈরি ৪ সংখ্যার রিপিটিং নম্বর ও হিটম্যাপ তালিকা।
      </p>

      {/* Mandatory Statistical Disclaimer */}
      <div class="mt-3 bg-amber-50 border border-amber-300 rounded-xl px-4 py-2 text-xs text-amber-900 inline-flex items-center gap-2 shadow-2xs">
        <span class="text-base">⚠️</span>
        <span class="font-medium">
          এই তথ্য শুধুমাত্র পূর্ববর্তী ফলাফলের পরিসংখ্যান ভিত্তিক; লটারির প্রতিটি ড্র সম্পূর্ণ স্বাধীন ও দৈবচয়ন ভিত্তিক।
        </span>
      </div>
    </div>

    {/* Interactive Analytics Module */}
    <AnalyticsModule
      client:load
      initialMatrix={analytics.matrix}
      initialHot={analytics.hotNumbers}
      initialCold={analytics.coldNumbers}
    />

    {/* Educational Content on Frequency Analysis */}
    <div class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 space-y-6 text-slate-700 shadow-sm">
      <h2 class="text-xl font-black text-slate-900">লটারি নম্বর বিশ্লেষণ কীভাবে বুঝবেন?</h2>
      <div class="grid md:grid-cols-2 gap-6 text-sm">
        <div class="space-y-2 bg-slate-50 p-5 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900">"হট নম্বর" (Hot Numbers) কী?</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            যেসব ৪ সংখ্যার নম্বর সাম্প্রতিক সপ্তাহগুলোতে একাধিকবার ৫ম পুরস্কার জিতেছে, তাদের হট নম্বর বলা হয়। অনেক খেলোয়াড় এই নম্বরগুলোকে বেশি প্রাধান্য দেন।
          </p>
        </div>

        <div class="space-y-2 bg-slate-50 p-5 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900">"কোল্ড নম্বর" (Cold Numbers) কী?</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            যেসব নম্বর দীর্ঘদিন ধরে সাম্প্রতিক ড্র-তে আসেনি, সেগুলোকে কোল্ড নম্বর বলা হয়। লটারির সম্ভাবনা অনুযায়ী যেকোনো ড্র-তে যেকোনো নম্বর ওঠার সুযোগ সমান থাকে।
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
