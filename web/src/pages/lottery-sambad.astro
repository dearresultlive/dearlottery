---
import Layout from '../layouts/Layout.astro';
import LiveResultsTabs from '../components/LiveResultsTabs';
import TicketChecker from '../components/TicketChecker';
import { fetchLatestDraws, fetchDrawsByDate } from '../lib/api';
import { getISTNow, getISTDateString } from '../lib/lottery-utils';

const istNow = getISTNow();
const todayDateStr = getISTDateString(istNow);

const yesterday = new Date(istNow);
yesterday.setDate(yesterday.getDate() - 1);
const yesterdayDateStr = getISTDateString(yesterday);

const draws = await fetchLatestDraws();
const yesterdayDraws = await fetchDrawsByDate(yesterdayDateStr);
const checkerDraws = [...draws, ...yesterdayDraws];
---

<Layout
  title={`Lottery Sambad Today Live (লটারি সংবাদ) • 1PM, 6PM, 8PM | Dear Lottery`}
  description={`Official Lottery Sambad (লটারি সংবাদ) results today for 1:00 PM Morning, 6:00 PM Day, and 8:00 PM Night. Nagaland State Lottery 1st Prize ₹1 Crore winning ticket numbers, gazette sheet PDF, and live draw updates.`}
  drawDate={todayDateStr}
>
  <div class="max-w-[620px] md:max-w-2xl lg:max-w-3xl mx-auto px-2.5 sm:px-4 py-2 sm:py-4 space-y-3 sm:space-y-4">
    
    {/* Breadcrumbs Navigation */}
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 border-b border-slate-200 pb-2">
      <a href="/" class="hover:text-blue-700 font-medium">Home (হোম)</a>
      <span>/</span>
      <span class="text-slate-900 font-bold">Lottery Sambad (লটারি সংবাদ)</span>
    </nav>

    {/* Entity Badge Header */}
    <div class="bg-gradient-to-r from-emerald-50 via-white to-emerald-50 border border-emerald-300 rounded-2xl p-3.5 text-center shadow-xs">
      <span class="inline-flex items-center gap-1.5 bg-emerald-600 text-white text-[10px] sm:text-xs font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider">
        <span>⭐</span>
        <span>Lottery Sambad Official Live Hub</span>
      </span>
      <h1 class="text-base sm:text-xl font-black text-slate-900 mt-1">
        Lottery Sambad Today Live • {todayDateStr} (লটারি সংবাদ)
      </h1>
      <p class="text-[11px] sm:text-xs text-slate-600 mt-0.5">
        Fastest official declaration for Nagaland &amp; Sikkim State Dear Lotteries.
      </p>
    </div>

    {/* Live Results Viewport */}
    <section id="results">
      <LiveResultsTabs client:load draws={draws} yesterdayDraws={yesterdayDraws} todayDateStr={todayDateStr} />
    </section>

    {/* Slim Ticket Checker */}
    <section id="checker">
      <TicketChecker client:load initialDraws={checkerDraws} variant="slim" />
    </section>

    {/* Deep Topical Guide on Lottery Sambad */}
    <section class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 text-slate-700 space-y-5 shadow-sm text-xs leading-relaxed">
      <h2 class="text-sm sm:text-base font-black text-slate-900">
        About Lottery Sambad (লটারি সংবাদ ও ডিয়ার লটারি)
      </h2>
      <p>
        <strong>Lottery Sambad (লটারি সংবাদ)</strong> is India's most popular daily lottery publication, covering official state lotteries including Nagaland State Lotteries, Sikkim State Lotteries, and West Bengal distributors. Daily draws offer a grand <strong>1st Prize of ₹1 Crore</strong> (including super prize), followed by 2nd prizes of ₹9,000, 3rd prizes of ₹450, 4th prizes of ₹250, and 5th prizes of ₹120.
      </p>

      <div class="border-t border-slate-100 pt-3 space-y-2">
        <h3 class="font-bold text-slate-900 text-xs sm:text-sm">Daily 3-Slot Draw Schedule:</h3>
        <div class="grid grid-cols-3 gap-2 text-center">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-2.5">
            <span class="font-black text-emerald-700 block">1:00 PM</span>
            <span class="text-[10px] text-slate-600">Morning Draw</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-2.5">
            <span class="font-black text-blue-700 block">6:00 PM</span>
            <span class="text-[10px] text-slate-600">Day Draw</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-2.5">
            <span class="font-black text-indigo-700 block">8:00 PM</span>
            <span class="text-[10px] text-slate-600">Night Draw</span>
          </div>
        </div>
      </div>

      <div class="border-t border-slate-100 pt-3 space-y-1 text-slate-500 text-[11px]">
        <p>
          ⚠️ <strong>Disclaimer:</strong> This website is an independent information service for public state lottery gazette results. Tickets are sold only through licensed state retailers. Players must be 18+ years of age.
        </p>
      </div>
    </section>

  </div>
</Layout>
