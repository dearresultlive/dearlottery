---
import Layout from '../layouts/Layout.astro';
import TicketChecker from '../components/TicketChecker';
import { fetchLatestDraws, fetchDrawsByDate } from '../lib/api';
import { getISTNow, getISTDateString } from '../lib/lottery-utils';

const istNow = getISTNow();
const yesterday = new Date(istNow);
yesterday.setDate(yesterday.getDate() - 1);

const draws = await fetchLatestDraws();
const yesterdayDraws = await fetchDrawsByDate(getISTDateString(yesterday));
const checkerDraws = [...draws, ...yesterdayDraws];

const checkerFaqItems = [
  {
    question: "How to check Dear Lottery ticket online?",
    answer: "Enter your 5-digit ticket number or the last 4 digits in the checker tool above. The checker instantly scans 1st prize ₹1 Crore, 2nd, 3rd, 4th, 5th, and consolation prize lists across today and yesterday's draws."
  },
  {
    question: "Do I need to enter the series letter to check my ticket?",
    answer: "No, entering just the 5 digits or last 4 digits will check all 3rd, 4th, and 5th prizes. The series letter (e.g., 84D) is only required to verify the 1st prize ₹1 Crore match."
  },
  {
    question: "How much is the consolation prize and how to qualify?",
    answer: "The consolation prize is ₹1,000. It is awarded when your ticket matches all 5 digits of the 1st prize winning ticket, but under a different series."
  }
];
---

<Layout
  title="Dear Lottery Instant Ticket Checker Online | Check 1st to 5th Prize"
  description="Check your Dear Lottery ticket number online instantly. Search by last 4-5 digits or full ticket number to see if you won 1st prize ₹1 Crore, 2nd, 3rd, 4th, or 5th prize."
  faqItems={checkerFaqItems}
>
  <div class="max-w-[620px] md:max-w-2xl lg:max-w-3xl mx-auto px-2.5 sm:px-4 py-2 sm:py-4 space-y-3 sm:space-y-4">
    
    {/* Breadcrumbs Navigation */}
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 border-b border-slate-200 pb-2">
      <a href="/" class="hover:text-blue-700 font-medium">Home (হোম)</a>
      <span>/</span>
      <span class="text-slate-900 font-bold">Ticket Checker (টিকিট চেকার)</span>
    </nav>

    {/* Page Header (Trilingual) */}
    <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 border border-blue-200 rounded-2xl p-3.5 text-center shadow-xs">
      <span class="inline-flex items-center gap-1.5 bg-blue-700 text-white text-[10px] sm:text-xs font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider">
        <span>⚡</span>
        <span class="lang-en">1-Second Instant Checker</span>
        <span class="lang-bn">১-সেকেন্ডে টিকিট মেলান</span>
        <span class="lang-hi">1-सेकंड में टिकट चेक करें</span>
      </span>
      <h1 class="text-base sm:text-xl font-black text-slate-900 mt-1">
        <span class="lang-en">Dear Lottery Instant Ticket Checker</span>
        <span class="lang-bn">অনলাইন ডিয়ার লটারি টিকিট চেকার</span>
        <span class="lang-hi">ऑनलाइन डियर लॉटरी टिकट चेकर</span>
      </h1>
      <p class="text-[11px] sm:text-xs text-slate-600 mt-0.5">
        <span class="lang-en">Check your ticket against 1st to 5th prize &amp; consolation numbers.</span>
        <span class="lang-bn">১ম থেকে ৫ম পুরস্কার ও সান্ত্বনা পুরস্কারের নম্বর নিমেষে মিলিয়ে নিন।</span>
        <span class="lang-hi">1st से 5th पुरस्कार और सांत्वना पुरस्कार के नंबर तुरंत चेक करें।</span>
      </p>
    </div>

    {/* Interactive Ticket Checker Island */}
    <section id="checker">
      <TicketChecker client:load initialDraws={checkerDraws} variant="slim" />
    </section>

    {/* Educational Content to Boost SEO & Dwell-Time (Trilingual) */}
    <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 space-y-4 text-slate-700 shadow-sm text-xs leading-relaxed">
      {/* English Instructions */}
      <div class="lang-en space-y-3">
        <h2 class="text-sm sm:text-base font-black text-slate-900">How to Check Your Lottery Ticket Number?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-blue-700 font-bold mb-1">1. Search by Last 4 Digits</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              3rd, 4th, and 5th prizes are awarded on the last 4 digits. Entering 4 digits checks 120+ winning lines immediately.
            </p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-amber-800 font-bold mb-1">2. Full 5-Digit Matching</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              2nd prize awards 10 five-digit winners of ₹10,000 each. For 1st prize (₹1 Crore), series letter and 5 digits must match.
            </p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-emerald-800 font-bold mb-1">3. Consolation Prize (₹1,000)</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              Matching all 5 digits of 1st prize with a different series code wins the ₹1,000 consolation prize.
            </p>
          </div>
        </div>
      </div>

      {/* Bengali Instructions */}
      <div class="lang-bn space-y-3">
        <h2 class="text-sm sm:text-base font-black text-slate-900">টিকিট নম্বর কীভাবে মেলাবেন?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-blue-700 font-bold mb-1">১. শেষের ৪ সংখ্যা দিয়ে খোঁজ</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              ৩য়, ৪র্থ ও ৫ম পুরস্কার মূলত শেষ ৪ সংখ্যার ওপর দেওয়া হয়। ৪টি সংখ্যা লিখলেই ১২০+ প্রাইজ নম্বরের সাথে সঙ্গে সঙ্গে মিলে যাবে।
            </p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-amber-800 font-bold mb-1">২. ৫টি সংখ্যার সম্পূর্ণ মিল</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              ২য় পুরস্কারে ১০টি পাঁচ সংখ্যার টিকিট থাকে (₹১০,০০০ টাকা)। ১ম পুরস্কারে ৫টি সংখ্যা এবং সিরিজের অক্ষর দুটোই মিলতে হয়।
            </p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-emerald-800 font-bold mb-1">৩. সান্ত্বনা পুরস্কার (₹১,০০০)</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              ১ম পুরস্কারের ৫টি সংখ্যার সাথে মিললে কিন্তু সিরিজ আলাদা হলে আপনি পাবেন ₹১,০০০ টাকা সান্ত্বনা পুরস্কার।
            </p>
          </div>
        </div>
      </div>

      {/* Hindi Instructions */}
      <div class="lang-hi space-y-3">
        <h2 class="text-sm sm:text-base font-black text-slate-900">लॉटरी टिकट नंबर कैसे चेक करें?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-blue-700 font-bold mb-1">1. अंतिम 4 अंकों से खोजें</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              तीसरे, चौथे और पांचवें पुरस्कार अंतिम 4 अंकों पर आधारित होते हैं। 4 अंक लिखने पर 120+ विजयी नंबरों से तुरंत मिलान हो जाता है।
            </p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-amber-800 font-bold mb-1">2. पूरे 5 अंकों का मिलान</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              दूसरे पुरस्कार में ₹10,000 के 10 पांच-अंकीय टिकट होते हैं। प्रथम पुरस्कार (₹1 करोड़) के लिए 5 अंक और सीरीज दोनों आवश्यक हैं।
            </p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div class="text-emerald-800 font-bold mb-1">3. सांत्वना पुरस्कार (₹1,000)</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              यदि टिकट के 5 अंक पहले पुरस्कार से मिलते हैं लेकिन सीरीज अलग है, तो ₹1,000 का सांत্বना पुरस्कार मिलता है।
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</Layout>
