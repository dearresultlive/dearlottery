      <div class="lang-en space-y-5">
        <h3 class="text-lg sm:text-xl font-black text-slate-900">Frequently Asked Questions (FAQ) • Dear Lottery</h3>
        <div class="grid md:grid-cols-2 gap-5 text-sm">
