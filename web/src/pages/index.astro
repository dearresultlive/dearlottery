---
import Layout from '../layouts/Layout.astro';
import DrawCountdown from '../components/DrawCountdown';
import TicketChecker from '../components/TicketChecker';
import PushNotifyBanner from '../components/PushNotifyBanner';
import LiveResultsTabs from '../components/LiveResultsTabs';
import { fetchLatestDraws, fetchDrawsByDate, fetchFrequencyAnalytics } from '../lib/api';
import { getISTNow, getISTDateString } from '../lib/lottery-utils';

const istNow = getISTNow();
const todayDateStr = getISTDateString(istNow);

const yesterday = new Date(istNow);
yesterday.setDate(yesterday.getDate() - 1);
const yesterdayDateStr = getISTDateString(yesterday);

const draws = await fetchLatestDraws();
const yesterdayDraws = await fetchDrawsByDate(yesterdayDateStr);
const analytics = await fetchFrequencyAnalytics();
---

<Layout
  title={`Dear Lottery Result Today ${todayDateStr} Live (1PM, 6PM, 8PM) | Lottery Sambad (লটারি সংবাদ)`}
  description={`Official Dear Lottery Result Today (${todayDateStr}) for 1:00 PM Morning, 6:00 PM Day, and 8:00 PM Night. 1st Prize ₹1 Crore winning ticket number, official gazette sheet JPG/PDF, and all prize tables.`}
  drawDate={todayDateStr}
>
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-8 space-y-6 sm:space-y-8">
    
    {/* 1. Sleek Mobile-First Live Draw Countdown Banner */}
    <div>
      <DrawCountdown client:load />
    </div>

    {/* 2. HERO: Instant Live Result Tables with Golden Ticket & Official Gazette Sheet */}
    <section id="results" class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs uppercase font-black tracking-widest text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">
              OFFICIAL LIVE GAZETTE
            </span>
            <span class="text-xs text-slate-400">•</span>
            <span class="text-xs text-slate-700 font-bold">লটারি সংবাদ</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight mt-1">
            Dear Lottery Result Today ({todayDateStr}) <span class="text-blue-700 text-lg sm:text-2xl block sm:inline font-bold sm:ml-2">আজকের ডিয়ার লটারি রেজাল্ট</span>
          </h1>
          <p class="text-slate-600 text-xs sm:text-sm mt-0.5">
            Nagaland & Sikkim State Lotteries official publication for 1:00 PM, 6:00 PM, and 8:00 PM draws.
          </p>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto">
          <a
            href="/analytics"
            class="text-xs font-bold text-blue-700 hover:text-blue-800 bg-blue-50 border border-blue-200 px-3 py-1.5 rounded-xl transition-colors shadow-2xs"
          >
            📊 Hot & Cold Numbers (হট নম্বর) →
          </a>
        </div>
      </div>

      <LiveResultsTabs client:load draws={draws} yesterdayDraws={yesterdayDraws} todayDateStr={todayDateStr} />
    </section>

    {/* 3. Optional Convenience Tool: Quick Ticket Search (Placed AFTER results) */}
    <section id="checker" class="space-y-4 pt-2">
      <div class="border-t border-slate-200 pt-6">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-lg">🔍</span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900">
            Quick Ticket Search (টিকিট নম্বর মেলান)
          </h2>
        </div>
        <p class="text-slate-600 text-xs sm:text-sm">
          Want to verify automatically? Enter your 5-digit number or last 4 digits below to check all prize tiers instantly.
        </p>
      </div>

      <TicketChecker client:load initialDraws={draws} />
    </section>

    {/* 4. Instant Result Notification Opt-in */}
    <section>
      <PushNotifyBanner client:load />
    </section>

    {/* 5. Player Analytics & Hot Numbers */}
    <section class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div>
          <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">
            Player Analytics & Number Trends / লটারি বিশ্লেষণ
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-slate-900">
            Most Frequent Repeating Numbers (৫ম পুরস্কারের হট নম্বর)
          </h3>
          <p class="text-slate-600 text-xs">
            Top repeating 4-digit numbers appearing in recent Dear Lottery draws.
          </p>
        </div>
        <a
          href="/analytics"
          class="bg-slate-50 border border-slate-200 hover:border-blue-400 text-blue-700 text-xs font-bold px-4 py-2 rounded-xl transition-all self-start sm:self-auto"
        >
          Full Analytics & Heatmap →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5">
        {analytics.hotNumbers.map((item, idx) => (
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-center">
            <span class="text-[10px] text-slate-500 block font-mono">HOT #{idx + 1}</span>
            <span class="text-xl sm:text-2xl font-mono font-black text-slate-950 block my-0.5">{item.ticket_number}</span>
            <span class="text-[11px] text-emerald-800 bg-emerald-100 border border-emerald-200 px-2 py-0.5 rounded-full font-bold">
              {item.occurrences}x drawn
            </span>
          </div>
        ))}
      </div>
    </section>

    {/* 6. Comprehensive SEO FAQ Schema Content */}
    <section class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 text-slate-700 space-y-5 shadow-sm">
      <h3 class="text-lg sm:text-xl font-black text-slate-900">Frequently Asked Questions (Dear Lottery FAQ / সাধারণ প্রশ্নোত্তর)</h3>
      
      <div class="grid md:grid-cols-2 gap-5 text-sm">
        <div class="space-y-1">
          <h4 class="font-bold text-slate-900">How much is the 1st prize in Dear Lottery?</h4>
          <p class="text-slate-600 text-xs leading-relaxed">
            The first prize for Dear Lottery is ₹1 Crore (₹10,000,000) including super prize amount. The prize is awarded to the ticket matching the exact series (e.g., 84D) and the 5-digit number.
          </p>
        </div>

        <div class="space-y-1">
          <h4 class="font-bold text-slate-900">What is the Dear Lottery Consolation Prize?</h4>
          <p class="text-slate-600 text-xs leading-relaxed">
            The Consolation Prize is ₹1,000, awarded to all other tickets bearing the same 5-digit number as the 1st prize across remaining series.
          </p>
        </div>

        <div class="space-y-1">
          <h4 class="font-bold text-slate-900">What are the daily Dear Lottery draw timings?</h4>
          <p class="text-slate-600 text-xs leading-relaxed">
            Draws are conducted thrice daily: 1:00 PM (Morning Draw), 6:00 PM (Day Draw), and 8:00 PM (Evening/Night Draw) under the authority of the Nagaland & Sikkim State Lotteries.
          </p>
        </div>

        <div class="space-y-1">
          <h4 class="font-bold text-slate-900">How do I verify and claim my prize?</h4>
          <p class="text-slate-600 text-xs leading-relaxed">
            Prizes below ₹10,000 can be claimed through authorized state lottery agents. For claims above ₹10,000, submit the undamaged ticket, claim form, and government photo ID to the State Lottery Directorate.
          </p>
        </div>
      </div>
    </section>

  </div>
</Layout>
