---
import Layout from '../layouts/Layout.astro';
import DrawCountdown from '../components/DrawCountdown';
import TicketChecker from '../components/TicketChecker';
import LiveResultsTabs from '../components/LiveResultsTabs';
import TelegramBanner from '../components/TelegramBanner.astro';
import { fetchLatestDraws, fetchDrawsByDate, fetchFrequencyAnalytics } from '../lib/api';
import { getISTNow, getISTDateString } from '../lib/lottery-utils';

const istNow = getISTNow();
const todayDateStr = getISTDateString(istNow);

const yesterday = new Date(istNow);
yesterday.setDate(yesterday.getDate() - 1);
const yesterdayDateStr = getISTDateString(yesterday);

const draws = await fetchLatestDraws();
const yesterdayDraws = await fetchDrawsByDate(yesterdayDateStr);
const checkerDraws = [...draws, ...yesterdayDraws];
const analytics = await fetchFrequencyAnalytics();

// High-Traffic Edge Caching Logic:
// Protects Cloudflare edge from 100k+ surges while delivering results within 5 seconds of release
const istHour = istNow.getHours();
const istMin = istNow.getMinutes();
// Live draw windows: 12:55 PM - 1:20 PM, 5:55 PM - 6:20 PM, 7:55 PM - 8:20 PM IST
const isLiveDrawWindow = 
  (istHour === 12 && istMin >= 55) || (istHour === 13 && istMin <= 20) ||
  (istHour === 17 && istMin >= 55) || (istHour === 18 && istMin <= 20) ||
  (istHour === 19 && istMin >= 55) || (istHour === 20 && istMin <= 20);

if (isLiveDrawWindow) {
  // During live draw: 5s edge micro-cache shields server from 50k spikes while delivering fresh result within 5s!
  // max-age=0 ensures user browser reload never serves stale cached image/numbers
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=5, stale-while-revalidate=15');
} else {
  // Outside draw rush: 15s browser / 60s edge cache ensures instant edge delivery with near-zero worker usage
  Astro.response.headers.set('Cache-Control', 'public, max-age=15, s-maxage=60, stale-while-revalidate=300');
}
---

<Layout
  title={`Dear Lottery Result Today ${todayDateStr} Live (1PM, 6PM, 8PM) • আজকের রেজাল্ট | Lottery Sambad`}
  description={`Official Dear Lottery Result Today (${todayDateStr}) for 1:00 PM Morning, 6:00 PM Day, and 8:00 PM Night. 1st Prize ₹1 Crore winning ticket number, official gazette sheet JPG/PDF, and all prize tables.`}
  drawDate={todayDateStr}
>
  <div class="max-w-[620px] md:max-w-2xl lg:max-w-3xl mx-auto px-2.5 sm:px-4 py-2 sm:py-4 space-y-3 sm:space-y-4">
    
    {/* 1. TOP VIEWPORT: Instant Live Result Tabs & 1st Prize Number (Zero clutter above fold for mobile users) */}
    <section id="results">
      <LiveResultsTabs client:load draws={draws} yesterdayDraws={yesterdayDraws} todayDateStr={todayDateStr} />
    </section>

    {/* 2. Instant Slim Ticket Checker (Hydrated When Scrolled Into View) */}
    <section id="checker">
      <TicketChecker client:visible initialDraws={checkerDraws} variant="slim" />
    </section>

    {/* Official Telegram Channel Join CTA */}
    <TelegramBanner />

    
    {/* Quick Target Numbers / Common Middle Prediction Teaser */}
    <a
