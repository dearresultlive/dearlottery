---
import Layout from '../../../layouts/Layout.astro';
import LiveResultsTabs from '../../../components/LiveResultsTabs';
import TicketChecker from '../../../components/TicketChecker';
import { fetchDrawsByDate } from '../../../lib/api';
import { getISTDateString } from '../../../lib/lottery-utils';

const { date } = Astro.params;
const targetDate = date || new Date().toISOString().slice(0, 10);
const draws = await fetchDrawsByDate(targetDate);

const prevDate = new Date(targetDate);
prevDate.setDate(prevDate.getDate() - 1);
const prevDateStr = getISTDateString(prevDate);
const prevDraws = await fetchDrawsByDate(prevDateStr);
---

<Layout
  title={`Dear Lottery Result ${targetDate} (1PM, 6PM, 8PM) Official Archive | Lottery Sambad`}
  description={`Official results archive for Dear Lottery draws on ${targetDate}. 1:00 PM Morning, 6:00 PM Day, and 8:00 PM Night 1st prize ₹1 Crore winning tickets.`}
  drawDate={targetDate}
>
  <div class="max-w-[580px] mx-auto px-2 sm:px-4 py-2 sm:py-4 space-y-3 sm:space-y-4">
    
    {/* Breadcrumbs Navigation */}
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 border-b border-slate-200 pb-2">
      <a href="/" class="hover:text-blue-700 font-medium">Home (হোম)</a>
      <span>/</span>
      <span class="text-slate-900 font-bold">Results ({targetDate})</span>
    </nav>

    {/* Header Info */}
    <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 border border-blue-200 rounded-2xl p-3.5 text-center shadow-xs">
      <span class="inline-flex items-center gap-1.5 bg-blue-700 text-white text-[10px] sm:text-xs font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider">
        <span>📅</span>
        <span>Official Gazette Archive • {targetDate}</span>
      </span>
      <h1 class="text-base sm:text-xl font-black text-slate-900 mt-1">
        Dear Lottery Results for {targetDate}
      </h1>
      <p class="text-[11px] sm:text-xs text-slate-600 mt-0.5">
        Nagaland &amp; Sikkim State Lotteries — 1:00 PM, 6:00 PM, and 8:00 PM draws.
      </p>
    </div>

    {/* Live Results Viewport */}
    <section id="results">
      <LiveResultsTabs client:load draws={draws} yesterdayDraws={prevDraws} todayDateStr={targetDate} />
    </section>

    {/* Scoped Ticket Checker */}
    <section id="checker">
      <TicketChecker client:load initialDraws={draws} variant="slim" />
    </section>

    {/* Quick Return to Today */}
    <div class="text-center pt-2">
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 bg-blue-700 hover:bg-blue-800 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-sm transition-all"
      >
        <span>👈</span>
        <span>Go to Today's Live Results (আজকের লাইভ রেজাল্ট)</span>
      </a>
    </div>

  </div>
</Layout>
