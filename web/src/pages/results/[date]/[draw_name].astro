---
import Layout from '../../../layouts/Layout.astro';
import LiveResultsTabs from '../../../components/LiveResultsTabs';
import TicketChecker from '../../../components/TicketChecker';
import TelegramBanner from '../../../components/TelegramBanner.astro';
import { fetchDrawsByDate } from '../../../lib/api';
import { getISTNow, getISTDateString } from '../../../lib/lottery-utils';

const { date, draw_name } = Astro.params;
const targetDate = date || getISTDateString();
const rawSlug = (draw_name || '').toLowerCase();

// Prevent static images and PDFs from executing SSR layout and poisoning Cloudflare HTML cache
if (rawSlug.endsWith('.jpg') || rawSlug.endsWith('.jpeg') || rawSlug.endsWith('.png') || rawSlug.endsWith('.webp') || rawSlug.endsWith('.avif')) {
  let targetSlot = '1pm';
  if (rawSlug.includes('6')) targetSlot = '6pm';
  else if (rawSlug.includes('8')) targetSlot = '8pm';
  return Astro.redirect(`/api/sheet-image?date=${targetDate}&slot=${targetSlot}`, 302);
}
if (rawSlug.endsWith('.pdf')) {
  let targetSlot = '1pm';
  if (rawSlug.includes('6')) targetSlot = '6pm';
  else if (rawSlug.includes('8')) targetSlot = '8pm';
  return Astro.redirect(`/pdf/${targetDate}/${targetSlot}.pdf`, 302);
}

// Fetch all draws for the target date
const allDraws = await fetchDrawsByDate(targetDate);

const prevDate = new Date(targetDate);
prevDate.setDate(prevDate.getDate() - 1);
const prevDateStr = getISTDateString(prevDate);
const prevDraws = await fetchDrawsByDate(prevDateStr);

// Resolve slot: 1PM, 6PM, 8PM
let activeSlot: '1PM' | '6PM' | '8PM' = '1PM';
if (rawSlug.includes('6') || rawSlug.includes('day')) {
  activeSlot = '6PM';
} else if (rawSlug.includes('8') || rawSlug.includes('night') || rawSlug.includes('eve')) {
  activeSlot = '8PM';
} else {
  activeSlot = '1PM';
}

const slotHour = activeSlot === '6PM' ? '6 PM' : activeSlot === '8PM' ? '8 PM' : '1 PM';
const slotKey = activeSlot.toLowerCase();

// Strict Slot Matching - Never fall back to another slot's draw!
const selectedDraw = allDraws.find(d => 
  d.draw_date === targetDate && (
  d.draw_time?.includes(activeSlot.replace('PM', '')) || 
  d.id?.includes(activeSlot))
);

const prizes = selectedDraw?.parsed_data?.prizes || selectedDraw?.prizes;
const firstPrize = prizes?.first_prize?.number ? prizes.first_prize : null;
const isDeclared = Boolean(firstPrize?.number);

const istNow = getISTNow();
const todayStr = getISTDateString(istNow);
const isToday = targetDate === todayStr;
const isFuture = targetDate > todayStr;

// Dynamic, Google Search Console compliant Titles & Descriptions:
let seoTitle = '';
let seoDesc = '';

if (isDeclared && firstPrize) {
  seoTitle = `Dear Lottery Result ${slotHour} (${targetDate}) • 1st Prize: ${firstPrize.series} ${firstPrize.number} | Official Gazette`;
  seoDesc = `Official Dear Lottery Sambad result for ${slotHour} draw on ${targetDate}. 1st Prize ₹1 Crore winning ticket is ${firstPrize.series} ${firstPrize.number}. Download official signed gazette PDF and check all prize tables.`;
} else if (isToday) {
  seoTitle = `Dear Lottery Result Today ${slotHour} Live - ${targetDate} | Lottery Sambad (লটারি সংবাদ)`;
  seoDesc = `Live tracking for official Dear Lottery Sambad ${slotHour} draw today (${targetDate}). Winning numbers and official signed gazette sheet will be published here live immediately upon declaration.`;
} else if (isFuture) {
  seoTitle = `Dear Lottery Result ${slotHour} (${targetDate}) • Schedule & Official Gazette | Lottery Sambad`;
  seoDesc = `Official Dear Lottery Sambad schedule and live tracking for ${slotHour} draw on ${targetDate}. 1st Prize ₹1 Crore and all prize tiers published live immediately upon draw release.`;
} else {
  seoTitle = `Dear Lottery Result ${slotHour} (${targetDate}) Archive | Lottery Sambad`;
  seoDesc = `Official Dear Lottery Sambad historical draw record for ${slotHour} on ${targetDate}. Download official state gazette PDF.`;
}

// Time-Aware Edge Caching:
if (!isToday) {
  // Past archive results are 100% permanent and immutable
  Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800');
} else if (isDeclared) {
  // Today's result is officially declared and confirmed
  Astro.response.headers.set('Cache-Control', 'public, max-age=30, s-maxage=120, stale-while-revalidate=600');
} else {
  // Today's result is upcoming or currently drawing: 5s micro-cache so user gets result immediately when uploaded
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=5, stale-while-revalidate=15');
}
---

<Layout
  title={seoTitle}
  description={seoDesc}
  drawDate={targetDate}
  drawTime={slotHour}
  winningNumbers={isDeclared && firstPrize ? { firstPrize: `${firstPrize.series} ${firstPrize.number}` } : undefined}
  preloadImage={{ url: `/results/${targetDate}/${slotKey}.avif`, type: 'image/avif' }}
>
  <div class="max-w-[620px] md:max-w-2xl lg:max-w-3xl mx-auto px-2.5 sm:px-4 py-3 sm:py-6 space-y-4 sm:space-y-6">
    
    {/* Breadcrumbs Navigation */}
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 border-b border-slate-200 pb-3">
      <a href="/" class="hover:text-blue-700 transition-colors">Home (হোম)</a>
      <span>/</span>
      <a href={`/results/${targetDate}`} class="hover:text-blue-700 transition-colors">Results {targetDate}</a>
      <span>/</span>
      <span class="text-slate-900 font-bold">{slotHour} Draw</span>
    </nav>

    {/* Live Results Viewport - Exact Image 2 experience with initial slot pre-selected */}
    <section id="results">
      <LiveResultsTabs
        client:load
        draws={allDraws}
        yesterdayDraws={prevDraws}
        todayDateStr={targetDate}
        initialSlot={activeSlot}
      />
    </section>

    {/* Scoped Ticket Checker */}
    <section id="checker">
      <TicketChecker client:load initialDraws={allDraws} variant="slim" />
    </section>

    {/* Official Telegram Channel Join CTA */}
    <TelegramBanner />

    {/* Prize Claim Information */}
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 space-y-4 text-slate-700 text-sm shadow-sm">
      <h3 class="text-base sm:text-lg font-black text-slate-900 flex items-center gap-2">
        <span>🏆</span>
        <span>How to Claim Dear Lottery Prizes (পুরস্কার দাবির নিয়মাবলী)</span>
      </h3>
      <ul class="space-y-2 text-xs text-slate-600 leading-relaxed list-disc list-inside">
        <li>
          <strong class="text-slate-900">Prizes up to ₹10,000:</strong> Can be collected in cash directly through any authorized Dear Lottery retailer or distributor with original intact ticket.
        </li>
        <li>
          <strong class="text-slate-900">Prizes above ₹10,000 (including 1st Prize ₹1 Crore):</strong> Must be claimed by submitting the original ticket, passport-size photos, PAN Card, Aadhaar Card, and the official claim form to the Directorate of State Lotteries within 30 days of result publication.
        </li>
        <li>
          <strong class="text-slate-900">Ticket Preservation:</strong> Damaged, mutilated, torn, or forged lottery tickets will not be accepted by government claim authorities.
        </li>
      </ul>
    </div>

  </div>
</Layout>
