---
import Layout from '../../../layouts/Layout.astro';
import ResultCard from '../../../components/ResultCard.astro';
import TicketChecker from '../../../components/TicketChecker';
import { fetchDrawsByDate } from '../../../lib/api';

const { date, draw_name } = Astro.params;
const targetDate = date || new Date().toISOString().slice(0, 10);
const rawSlug = (draw_name || '').toLowerCase();

// Fetch all draws for the target date
const allDraws = await fetchDrawsByDate(targetDate);

// Resolve specific draw matching the slug
let selectedDraw = allDraws.find((d) => {
  const normTime = d.draw_time?.toLowerCase().replace(/[^a-z0-9]/g, '');
  const normName = d.draw_name?.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  return (
    rawSlug.includes(normTime) ||
    (normName && rawSlug.includes(normName)) ||
    (normName && normName.includes(rawSlug))
  );
});

// Fallback to first draw if not matched exactly
if (!selectedDraw && allDraws.length > 0) {
  if (rawSlug.includes('6pm') || rawSlug.includes('day')) {
    selectedDraw = allDraws.find(d => d.draw_time?.includes('6')) || allDraws[1] || allDraws[0];
  } else if (rawSlug.includes('8pm') || rawSlug.includes('night') || rawSlug.includes('evening')) {
    selectedDraw = allDraws.find(d => d.draw_time?.includes('8')) || allDraws[2] || allDraws[0];
  } else {
    selectedDraw = allDraws[0];
  }
}

const draw = selectedDraw || allDraws[0];
const prizes = draw?.parsed_data?.prizes || draw?.prizes;
const firstPrize = prizes?.first_prize || { series: '84D', number: '19283' };

// SEO Meta Data
const seoTitle = `${draw.draw_name} Result ${targetDate} (${draw.draw_time}) | 1st Prize ₹1 Crore ${firstPrize.series} ${firstPrize.number}`;
const seoDesc = `Official ${draw.draw_name} (${draw.draw_time}) lottery result declared on ${targetDate}. 1st Prize ₹1 Crore winning ticket is ${firstPrize.series} ${firstPrize.number}. Check all 2nd, 3rd, 4th, 5th prizes online.`;
---

<Layout
  title={seoTitle}
  description={seoDesc}
  drawDate={targetDate}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    {/* Breadcrumbs Navigation */}
    <nav class="flex items-center gap-2 text-xs text-slate-400 border-b border-slate-800 pb-3">
      <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <a href={`/results/${targetDate}`} class="hover:text-emerald-400 transition-colors">Results {targetDate}</a>
      <span>/</span>
      <span class="text-white font-semibold">{draw.draw_name} ({draw.draw_time})</span>
    </nav>

    {/* Header Banner */}
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
            {draw.draw_time} Official Draw Sheet
          </span>
          <span class="text-xs text-slate-400 font-mono">
            Date: {targetDate}
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-white">
          {draw.draw_name} Result
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Directorate of Nagaland & Sikkim State Lotteries official publication.
        </p>
      </div>

      {/* Cross-navigation to other draws of the same day */}
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs text-slate-400 block w-full md:w-auto">Other Draws Today:</span>
        {allDraws.filter(d => d.id !== draw.id).map(d => {
          const slotTag = d.draw_time?.toLowerCase().includes('1') ? '1pm' : (d.draw_time?.toLowerCase().includes('6') ? '6pm' : '8pm');
          const slug = `${slotTag}-${d.draw_name?.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
          return (
            <a
              href={`/results/${targetDate}/${slug}`}
              class="bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-bold text-slate-200 px-3 py-1.5 rounded-xl transition-colors"
            >
              {d.draw_time} →
            </a>
          );
        })}
      </div>
    </div>

    {/* Primary Result Sheet */}
    <section>
      <ResultCard draw={draw} />
    </section>

    {/* Scoped Ticket Checker */}
    <section class="space-y-4">
      <div class="border-t border-slate-800 pt-8">
        <h2 class="text-2xl font-black text-white mb-2">
          Verify Your Ticket in {draw.draw_name}
        </h2>
        <p class="text-slate-400 text-xs">
          Instantly search your ticket against this exact {draw.draw_time} draw or all prize tiers.
        </p>
      </div>
      <TicketChecker client:load initialDraws={[draw]} />
    </section>

    {/* Prize Claim Information */}
    <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 text-slate-300 text-sm">
      <h3 class="text-lg font-bold text-white">How to Claim Dear Lottery Prizes</h3>
      <ul class="space-y-2 text-xs text-slate-400 leading-relaxed list-disc list-inside">
        <li>
          <strong class="text-white">Prizes up to ₹10,000:</strong> Can be collected in cash directly through any authorized Dear Lottery retailer or distributor with original intact ticket.
        </li>
        <li>
          <strong class="text-white">Prizes above ₹10,000 (including 1st Prize ₹1 Crore):</strong> Must be claimed by submitting the original ticket, passport-size photos, PAN Card, Aadhaar Card, and the official claim form to the Directorate of State Lotteries within 30 days of result publication.
        </li>
        <li>
          <strong class="text-white">Ticket Preservation:</strong> Damaged, mutilated, torn, or forged lottery tickets will not be accepted by government claim authorities.
        </li>
      </ul>
    </div>

  </div>
</Layout>
