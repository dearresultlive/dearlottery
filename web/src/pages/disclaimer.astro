---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Official Disclaimer | Dear Result Live (দাবি পরিত্যাগ)"
  description="Official 3rd-party independent disclaimer for Dear Result Live. Not affiliated with Nagaland, Sikkim, or West Bengal State Lotteries."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8 text-slate-300">
    
    <div class="border-b border-slate-800 pb-6">
      <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">Legal Notice</span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mt-1">
        Official Disclaimer (দাবি পরিত্যাগ)
      </h1>
      <p class="text-slate-400 text-sm mt-2">
        Independent third-party status and verification disclaimer.
      </p>
    </div>

    <div class="space-y-6 text-sm leading-relaxed">
      <section class="bg-slate-900 border-2 border-amber-500/40 rounded-3xl p-6 sm:p-8 space-y-3">
        <h2 class="text-xl font-black text-amber-400 flex items-center gap-2">
          <span>🛡️</span>
          <span>Non-Affiliation Notice (স্বতন্ত্র বিজ্ঞপ্তি)</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Dear Result Live (<strong>dearresultlive.in</strong>) is an independent, privately operated web platform and is <strong>NOT affiliated with, sponsored by, endorsed by, or connected to</strong> the Government of Nagaland, Government of Sikkim, Government of West Bengal, Directorate of Nagaland State Lotteries, or any official lottery organizing body.
        </p>
      </section>

      <section class="space-y-3">
        <h3 class="text-lg font-bold text-white">Cross-Verification Advisory</h3>
        <p>
          While we strive to ensure 100% transcription accuracy through automated OCR and double-pass verification, readers and ticket holders are strongly advised to verify winning numbers with the official published Government Gazette before claiming prizes or discarding tickets.
        </p>
        <p>
          Dear Result Live shall not be held liable for any loss, damage, misinterpretation, or claim arising from the use of data published on this website.
        </p>
      </section>

      <section class="space-y-3">
        <h3 class="text-lg font-bold text-white">No Ticket Sales & 18+ Advisory</h3>
        <p>
          This website does not sell lottery tickets, solicit lottery investments, or operate any gambling games. Lottery participation is permitted only in designated legal states in India and is strictly restricted to adults aged 18 and older.
        </p>
      </section>
    </div>

  </div>
</Layout>
