---
interface Props {
  variant?: 'banner' | 'card' | 'compact';
}

const { variant = 'banner' } = Astro.props;
const whatsappChannelUrl = 'https://whatsapp.com/channel/0029Vb9QMeoInlqLecSjJ927';
const telegramChannelUrl = 'https://t.me/dearresultlive';
---

<div class="relative overflow-hidden bg-gradient-to-br from-emerald-50/80 via-white to-sky-50/70 text-slate-900 p-3.5 sm:p-4 rounded-2xl shadow-sm border border-emerald-200/90 group">
  {/* Ambient background glows */}
  <div class="absolute -right-10 -bottom-10 w-44 h-44 bg-emerald-400/10 rounded-full blur-2xl pointer-events-none group-hover:scale-125 transition-transform duration-700"></div>
  <div class="absolute -left-10 -top-10 w-36 h-36 bg-sky-400/10 rounded-full blur-2xl pointer-events-none"></div>

  {/* Header Section: Logos + Headline + Urgency Badge */}
  <div class="relative z-10 flex items-start gap-3 mb-3">
    {/* Combined Overlapping Brand Badges */}
    <div class="flex items-center -space-x-2 flex-shrink-0 mt-0.5">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl bg-[#25D366] text-white flex items-center justify-center shadow-md ring-2 ring-white group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.14 15.86C14.16 16.73 14.57 16.56 15.02 16.52C15.46 16.47 16.46 15.92 16.67 15.33C16.87 14.75 16.87 14.25 16.81 14.15C16.75 14.05 16.59 13.99 16.35 13.87C16.1 13.75 14.91 13.16 14.69 13.08C14.47 13 14.31 12.96 14.15 13.2C13.99 13.45 13.52 14.01 13.38 14.17C13.24 14.33 13.1 14.35 12.86 14.23C12.61 14.11 11.82 13.85 10.88 13.01C10.15 12.36 9.66 11.55 9.52 11.31C9.38 11.07 9.5 10.94 9.62 10.82C9.73 10.71 9.87 10.53 10 10.38C10.12 10.22 10.16 10.1 10.24 9.94C10.32 9.78 10.28 9.64 10.22 9.52C10.16 9.4 9.69 8.24 9.49 7.77C9.3 7.3 9.1 7.37 8.95 7.36C8.81 7.35 8.67 7.33 8.53 7.33Z"/>
        </svg>
      </div>
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#229ED9] text-white flex items-center justify-center shadow-sm ring-2 ring-white">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
        </svg>
      </div>
    </div>
    
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs sm:text-sm font-black uppercase tracking-wider block text-slate-900">
          <span class="lang-en">Official Alert Communities</span>
          <span class="lang-bn">অফিসিয়াল রেজাল্ট চ্যানেল</span>
          <span class="lang-hi">ऑफिशियल रिजल्ट चैनल</span>
        </span>
        <span class="bg-rose-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider flex-shrink-0 shadow-xs">
          FAST
        </span>
      </div>
      <p class="text-[11px] sm:text-xs text-slate-600 font-medium mt-0.5 leading-snug">
        <span class="lang-en">Get instant ₹1 Cr winner ticket numbers &amp; gazette PDFs on your phone!</span>
        <span class="lang-bn">ড্র হওয়া মাত্র ১ম পুরস্কার ₹১ কোটি নম্বর ও গেজেট PDF সবার আগে ফোনে পেতে জয়েন করুন!</span>
        <span class="lang-hi">ड्रॉ होते ही प्रथम पुरस्कार ₹1 करोड़ का नंबर और गजট पीडीएफ सीधे अपने फोन पर पाएं!</span>
      </p>
    </div>
  </div>

  {/* High-Converting Full-Width Stacked Buttons (Thumb Zone Optimized) */}
  <div class="relative z-10 flex flex-col gap-2.5 w-full">
    {/* 1. Primary Priority: WhatsApp Channel (Full Width, Top) */}
    <a
      href={whatsappChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full bg-[#25D366] hover:bg-[#20bd5a] text-white font-black px-3.5 py-2.5 sm:py-3 rounded-xl shadow-sm hover:shadow transition-all active:scale-[0.99] flex items-center justify-between gap-2.5 cursor-pointer group/wa"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0 group-hover/wa:scale-110 transition-transform text-white">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.14 15.86C14.16 16.73 14.57 16.56 15.02 16.52C15.46 16.47 16.46 15.92 16.67 15.33C16.87 14.75 16.87 14.25 16.81 14.15C16.75 14.05 16.59 13.99 16.35 13.87C16.1 13.75 14.91 13.16 14.69 13.08C14.47 13 14.31 12.96 14.15 13.2C13.99 13.45 13.52 14.01 13.38 14.17C13.24 14.33 13.1 14.35 12.86 14.23C12.61 14.11 11.82 13.85 10.88 13.01C10.15 12.36 9.66 11.55 9.52 11.31C9.38 11.07 9.5 10.94 9.62 10.82C9.73 10.71 9.87 10.53 10 10.38C10.12 10.22 10.16 10.1 10.24 9.94C10.32 9.78 10.28 9.64 10.22 9.52C10.16 9.4 9.69 8.24 9.49 7.77C9.3 7.3 9.1 7.37 8.95 7.36C8.81 7.35 8.67 7.33 8.53 7.33Z"/>
          </svg>
        </div>
        <div class="text-left min-w-0">
          <span class="text-xs sm:text-sm font-black uppercase tracking-wide block leading-tight text-white drop-shadow-xs">
            Follow WhatsApp Channel
          </span>
          <span class="text-[10px] sm:text-[11px] font-semibold text-emerald-100 block truncate">
            Results Direct in Your WhatsApp Updates
          </span>
        </div>
      </div>
      <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-white/25 text-white flex items-center justify-center text-xs font-black flex-shrink-0 group-hover/wa:translate-x-0.5 transition-transform">
        ➔
      </div>
    </a>

    {/* 2. Secondary: Telegram Channel (Full Width, Stacked Second) */}
    <a
      href={telegramChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full bg-[#0284c7] hover:bg-[#0369a1] text-white font-bold px-3.5 py-2.5 sm:py-3 rounded-xl shadow-sm hover:shadow transition-all active:scale-[0.99] flex items-center justify-between gap-2.5 cursor-pointer group/tg"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0 group-hover/tg:scale-110 transition-transform text-white">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
        </div>
        <div class="text-left min-w-0">
          <span class="text-xs sm:text-sm font-black uppercase tracking-wide block leading-tight text-white drop-shadow-xs">
            Join Telegram Channel
          </span>
          <span class="text-[10px] sm:text-[11px] font-medium text-sky-100 block truncate">
            Instant 0-Sec Result Alerts &amp; Target Tips
          </span>
        </div>
      </div>
      <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-white/25 text-white flex items-center justify-center text-xs font-black flex-shrink-0 group-hover/tg:translate-x-0.5 transition-transform">
        ➔
      </div>
    </a>
  </div>
</div>
