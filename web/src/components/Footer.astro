---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100 border-t border-slate-200 mt-16 pt-10 pb-8 text-slate-600 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-slate-200">
      
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-amber-500 to-yellow-400 flex items-center justify-center text-slate-950 font-black text-base shadow-sm">
            ₹
          </div>
          <div>
            <span class="font-black text-base text-slate-900 tracking-wide">DEAR RESULT LIVE</span>
            <span class="block text-[10px] text-blue-700 font-bold">ডিয়ার লটারি রেজাল্ট লাইভ পোর্টাল</span>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed max-w-md text-xs">
          Dear Result Live (<strong>dearresultlive.in</strong>) is a fast, trusted, independent public utility portal for checking official Nagaland, Sikkim, and West Bengal Dear State Lottery results. We publish winning numbers accurately for all daily 1:00 PM (দুপুর), 6:00 PM (সন্ধ্যা), and 8:00 PM (রাত) draws.
        </p>
      </div>

      <div>
        <h4 class="font-bold text-slate-900 uppercase tracking-wider mb-3 text-xs flex items-center gap-1.5">
          <span>📅</span>
          <span>দৈনিক লটারি ড্র (Daily Draws)</span>
        </h4>
        <ul class="space-y-2">
          <li><a href="/results/2026-10-14/1pm" class="hover:text-blue-700 transition-colors">1:00 PM দুপুর ১টা (Morning)</a></li>
          <li><a href="/results/2026-10-14/6pm" class="hover:text-blue-700 transition-colors">6:00 PM সন্ধ্যা ৬টা (Day)</a></li>
          <li><a href="/results/2026-10-14/8pm" class="hover:text-blue-700 transition-colors">8:00 PM রাত ৮টা (Night)</a></li>
          <li><a href="/checker" class="hover:text-blue-700 transition-colors">টিকিট মেলান (Ticket Checker)</a></li>
          <li><a href="/analytics" class="hover:text-blue-700 transition-colors">হট ও কোল্ড নম্বর (নম্বর বিশ্লেষণ)</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-slate-900 uppercase tracking-wider mb-3 text-xs flex items-center gap-1.5">
          <span>⚖️</span>
          <span>জরুরি নিয়মাবলী ও যোগাযোগ</span>
        </h4>
        <ul class="space-y-2">
          <li><a href="/about" class="hover:text-blue-700 transition-colors">আমাদের সম্পর্কে</a></li>
          <li><a href="/contact" class="hover:text-blue-700 transition-colors">যোগাযোগ করুন</a></li>
          <li><a href="/privacy-policy" class="hover:text-blue-700 transition-colors">গোপনীয়তা নীতি</a></li>
          <li><a href="/terms" class="hover:text-blue-700 transition-colors">ব্যবহারের শর্তাবলী</a></li>
          <li><a href="/disclaimer" class="hover:text-blue-700 transition-colors">অফিসিয়াল ডিসক্লেইমার</a></li>
        </ul>
      </div>

    </div>

    {/* Legal & Regulatory Disclaimer */}
    <div class="bg-white border border-slate-200 rounded-xl p-4 mb-6 leading-relaxed text-[11px] text-slate-600 space-y-2 shadow-2xs">
      <div class="flex items-center gap-2 text-slate-900 font-bold uppercase tracking-wider text-xs">
        <span>🛡️</span>
        <span>স্বতন্ত্র তথ্যসেবা ও সরকারি আইনি বিজ্ঞপ্তি (Legal Notice)</span>
