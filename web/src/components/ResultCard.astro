---
import { formatINR } from '../lib/lottery-utils';

interface Props {
  draw: any;
}

const { draw } = Astro.props;
const p = draw.parsed_data?.prizes || draw.prizes;
const first = p?.first_prize || { series: '84D', number: '74921' };
const second = p?.second_prize || [];
const third = p?.third_prize || [];
const fourth = p?.fourth_prize || [];
const fifth = p?.fifth_prize || [];

const slotTag = draw.draw_time?.toLowerCase().includes('1') ? '1pm' : (draw.draw_time?.toLowerCase().includes('6') ? '6pm' : '8pm');
const pdfUrl = draw.pdf_r2_url || `/pdf/${draw.draw_date}/${slotTag}.pdf`;
const jpgUrl = draw.image_r2_url || `/og-image.jpg?date=${draw.draw_date}&slot=${slotTag}`;

const whatsappMessage = `🎯 *Dear Lottery Result (${draw.draw_time || 'Live'})*\n📅 তারিখ: ${draw.draw_date}\n\n🏆 *১ম পুরস্কার (₹1 Crore Winner)*: *${first.series} ${first.number}*\n\n👉 সম্পূর্ণ রেজাল্ট শিট ও টিকিট চেক করুন:\nhttps://dearresultlive.in/results/${draw.draw_date}`;
const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(whatsappMessage)}`;
---

<div class="bg-slate-900 border-2 border-slate-800 rounded-3xl p-4 sm:p-8 shadow-2xl relative overflow-hidden space-y-6 print:border-none print:shadow-none print:p-0">
  
  {/* Header Info */}
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-800 gap-3">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="bg-red-500 text-white font-black text-[10px] sm:text-xs px-2.5 py-0.5 rounded-full uppercase tracking-wider animate-pulse flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
          OFFICIAL GAZETTE RECORD
        </span>
        <span class="text-xs text-amber-400 font-bold font-mono">
          {draw.draw_date}
        </span>
        <span class="text-xs text-slate-400">
          • {draw.draw_time} Draw
        </span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
        {draw.draw_name}
      </h3>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs text-slate-400 font-mono bg-slate-950 border border-slate-800 px-3 py-1.5 rounded-xl">
        Draw #{draw.draw_number || '74'}
      </span>
      <button
        onclick="window.print()"
        class="bg-slate-950 hover:bg-slate-800 border border-slate-700 text-slate-300 text-xs font-bold px-3 py-1.5 rounded-xl transition-colors print:hidden"
      >
        🖨️ Print
      </button>
    </div>
  </div>

  {/* 1. Hero Section: "1st Prize Winner Card" (High-Contrast Golden/Amber Card) */}
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-amber-500/25 via-yellow-500/15 to-amber-600/25 border-2 border-amber-400 p-6 sm:p-8 text-center shadow-2xl">
    <div class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 text-xs sm:text-sm font-black uppercase tracking-wider px-4 py-1.5 rounded-full shadow-md mb-4">
      <span>🏆</span>
      <span>1st Prize: ₹1,00,00,000 (1 Crore Winner / ১ম পুরস্কার)</span>
    </div>

    {/* Ticket Number in Bold 28px+ Font */}
    <div class="py-2">
      <div class="text-4xl sm:text-6xl md:text-7xl font-black font-mono text-amber-300 tracking-widest drop-shadow-[0_4px_16px_rgba(251,191,36,0.35)] select-all">
        {first.series} {first.number}
      </div>
    </div>

    {/* Consolation Prize Badge */}
    <div class="mt-4 pt-4 border-t border-amber-500/30 flex flex-col sm:flex-row items-center justify-center gap-2 text-xs sm:text-sm text-amber-200">
      <span class="bg-amber-400/20 text-amber-300 border border-amber-400/40 font-bold px-3 py-1 rounded-full uppercase tracking-wider text-xs">
        Consolation Prize: ₹1,000 (সান্ত্বনা পুরস্কার)
      </span>
      <span class="text-amber-100/90 font-medium">
        Applicable to all remaining series of ticket <strong class="font-mono text-white text-base underline decoration-amber-400">{first.number}</strong>
      </span>
    </div>
  </div>

  {/* 2. Official Result Media & Social Utility Bar (3 Trust Actions) */}
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 print:hidden">
    {/* Button 1: View Official JPG Sheet */}
    <a
      href={jpgUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 bg-slate-950 hover:bg-slate-800 text-amber-300 hover:text-white border-2 border-amber-500/40 hover:border-amber-400 font-bold text-xs sm:text-sm py-3 px-4 rounded-2xl shadow transition-all active:scale-98"
    >
      <span class="text-base">📄</span>
      <span>View Official Sheet / শিট দেখুন</span>
    </a>

    {/* Button 2: Download Gazette PDF */}
    <a
      href={pdfUrl}
      target="_blank"
      rel="noopener noreferrer"
      download={`Dear_Lottery_${draw.draw_date}.pdf`}
      class="flex items-center justify-center gap-2 bg-slate-950 hover:bg-slate-800 text-emerald-400 hover:text-white border-2 border-emerald-500/40 hover:border-emerald-400 font-bold text-xs sm:text-sm py-3 px-4 rounded-2xl shadow transition-all active:scale-98"
    >
      <span class="text-base">📥</span>
      <span>Download PDF / পিডিএফ</span>
    </a>

    {/* Button 3: WhatsApp Share Trigger */}
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-white font-black text-xs sm:text-sm py-3 px-4 rounded-2xl shadow-lg shadow-emerald-600/30 transition-all active:scale-98"
    >
      <span class="text-lg">📲</span>
      <span>Share on WhatsApp / শেয়ার</span>
    </a>
  </div>

  {/* 3. 2nd Prize Table (10 Tickets of ₹9,000 Each) */}
  <div class="bg-slate-950/90 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3">
    <div class="flex items-center justify-between border-b border-slate-800 pb-2.5">
      <h4 class="text-sm sm:text-base font-extrabold text-white flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        <span>2nd Prize: {formatINR(9000)} (১০ জন বিজয়ী)</span>
      </h4>
      <span class="text-xs text-emerald-400 font-bold font-mono">5 Digits / ৫ সংখ্যা</span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5">
      {second.map((num: string) => (
        <div class="bg-slate-900 border-2 border-slate-800 hover:border-emerald-500/60 rounded-xl py-2.5 px-3 text-center font-mono text-lg sm:text-xl font-black text-emerald-300 tracking-wider shadow-inner select-all">
          {num}
        </div>
      ))}
    </div>
  </div>

  {/* 4. 3rd & 4th Prizes */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {/* 3rd Prize (₹450 Each) */}
    <div class="bg-slate-950/90 border border-slate-800 rounded-2xl p-4 space-y-3">
      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <h5 class="text-xs sm:text-sm font-bold text-slate-200 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-400"></span>
          <span>3rd Prize: {formatINR(450)} (৩য় পুরস্কার)</span>
        </h5>
        <span class="text-[11px] text-slate-400 font-mono">Last 4 Digits</span>
      </div>
      <div class="grid grid-cols-5 gap-2">
        {third.map((num: string) => (
          <div class="bg-slate-900 border border-slate-800 hover:border-teal-400/50 rounded-lg py-2 text-center font-mono text-base font-bold text-slate-100 tracking-wider select-all">
            {num}
          </div>
        ))}
      </div>
    </div>

    {/* 4th Prize (₹250 Each) */}
    <div class="bg-slate-950/90 border border-slate-800 rounded-2xl p-4 space-y-3">
      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <h5 class="text-xs sm:text-sm font-bold text-slate-200 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-400"></span>
          <span>4th Prize: {formatINR(250)} (৪র্থ পুরস্কার)</span>
        </h5>
        <span class="text-[11px] text-slate-400 font-mono">Last 4 Digits</span>
      </div>
      <div class="grid grid-cols-5 gap-2">
        {fourth.map((num: string) => (
          <div class="bg-slate-900 border border-slate-800 hover:border-blue-400/50 rounded-lg py-2 text-center font-mono text-base font-bold text-slate-100 tracking-wider select-all">
            {num}
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* 5. 5th Prize: 100 Numbers (₹120 Each - High Contrast Mobile Scanning Grid) */}
  <div class="bg-slate-950/90 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-800 pb-2.5 gap-1">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
        <h5 class="text-sm sm:text-base font-black text-white">
          5th Prize: {formatINR(120)} (৫ম পুরস্কার - ১০০ জন বিজয়ী)
        </h5>
      </div>
      <span class="text-xs text-amber-400 font-mono font-bold">
        Matches Last 4 Digits / শেষ ৪ সংখ্যা
      </span>
    </div>

    <div class="grid grid-cols-5 sm:grid-cols-10 gap-1.5 sm:gap-2 pt-1">
      {fifth.map((num: string) => (
        <div class="bg-slate-900/95 border border-slate-800 hover:border-amber-400 hover:bg-slate-800 rounded-lg py-1.5 text-center font-mono text-sm sm:text-base font-bold text-slate-100 tracking-wider transition-colors select-all shadow-sm">
          {num}
        </div>
      ))}
    </div>
  </div>

</div>
