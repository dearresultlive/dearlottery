---
import LanguageToggle from './LanguageToggle';
import NotificationBell from './NotificationBell';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-1.5 sm:gap-4">
      
      {/* Brand Logo - Authentic Local Lottery Portal Identity */}
      <a href="/" class="flex items-center gap-2 sm:gap-3 group min-w-0 flex-shrink">
        <div class="w-8 h-8 sm:w-11 sm:h-11 rounded-xl sm:rounded-2xl bg-gradient-to-tr from-amber-500 via-amber-400 to-yellow-500 flex items-center justify-center text-slate-950 font-black text-lg sm:text-2xl shadow-sm flex-shrink-0 group-hover:scale-105 transition-transform">
          ₹
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1 sm:gap-1.5">
            <span class="font-black text-xs sm:text-lg tracking-tight text-slate-900 group-hover:text-blue-700 transition-colors whitespace-nowrap">
              DEAR RESULT LIVE
            </span>
            <span class="bg-red-600 text-white font-black text-[8px] sm:text-[10px] px-1 sm:px-1.5 py-0.2 rounded-full uppercase tracking-wider animate-pulse shadow-2xs flex-shrink-0">
              LIVE
            </span>
          </div>
          <span class="text-[9px] sm:text-[11px] text-blue-700 font-bold tracking-tight block truncate">
            লটারি সংবাদ • আজকের তাজা রেজাল্ট
          </span>
        </div>
      </a>

      {/* Navigation Desktop */}
      <nav class="hidden md:flex items-center gap-1">
        <a
          href="/"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          আজকের রেজাল্ট
        </a>
        <a
          href="/old-results"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/old-results'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          পুরনো রেজাল্ট
        </a>
        <a
          href="/checker"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/checker'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          টিকিট মেলান
        </a>
        <a
          href="/analytics"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/analytics'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          হট নম্বর
        </a>
      </nav>

      {/* Controls: Notification Bell + Language Toggle + Ticket Checker Button */}
      <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
        <NotificationBell client:load />
        <LanguageToggle client:load />

        <a
          href="/checker"
          aria-label="Ticket Checker"
          class="inline-flex items-center gap-1 bg-blue-700 hover:bg-blue-800 text-white text-[11px] sm:text-xs font-black px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg sm:rounded-xl shadow-xs transition-all active:scale-95"
        >
          <span>🔍</span>
          <span class="hidden sm:inline">টিকিট মেলান</span>
          <span class="sm:hidden">মেলান</span>
        </a>
      </div>

    </div>
  </div>
</header>
