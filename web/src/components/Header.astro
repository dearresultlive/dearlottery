---
import LanguageToggle from './LanguageToggle';
import NotificationBell from './NotificationBell';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-1.5 sm:gap-4">
      
      {/* Brand Logo - Authentic Local Lottery Portal Identity */}
      <a href="/" class="flex items-center gap-2 sm:gap-3 group flex-shrink-0">
        <img
          src="/favicon.svg"
          alt="Dear Result Live"
          class="w-8 h-8 sm:w-11 sm:h-11 rounded-xl sm:rounded-2xl shadow-sm flex-shrink-0 group-hover:scale-105 transition-transform"
        />
        <div class="flex-shrink-0">
          <div class="flex items-center gap-1 sm:gap-1.5">
            <span class="font-black text-xs sm:text-lg tracking-tight text-slate-900 group-hover:text-blue-700 transition-colors whitespace-nowrap">
              DEAR RESULT LIVE
            </span>
            <span class="bg-red-600 text-white font-black text-[8px] sm:text-[10px] px-1 sm:px-1.5 py-0.2 rounded-full uppercase tracking-wider animate-pulse shadow-2xs flex-shrink-0">
              LIVE
            </span>
          </div>
          <span id="header-brand-tagline" class="text-[9px] sm:text-[11px] text-blue-700 font-bold tracking-tight block whitespace-nowrap">
            Lottery Sambad • Live Result Portal
          </span>
        </div>
      </a>

      {/* Navigation Desktop */}
      <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1.5 flex-shrink min-w-0">
        <a
          href="/"
          class={`px-2 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-black whitespace-nowrap transition-colors ${
            currentPath === '/'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-today">Today</span>
        </a>
        <a
          href="/lucky-ticket"
          class={`px-2 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-black whitespace-nowrap transition-colors ${
            currentPath === '/lucky-ticket' || currentPath === '/demo'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-lucky">Lucky Ticket</span>
        </a>
        <a
          href="/yesterday"
          class={`px-2 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-black whitespace-nowrap transition-colors ${
            currentPath === '/yesterday'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-yesterday">Yesterday</span>
        </a>
        <a
          href="/target-numbers"
          class={`px-2 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-black whitespace-nowrap transition-colors ${
            currentPath === '/target-numbers'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-target">Target & Hot</span>
        </a>
        <a
          href="/old-results"
          class={`px-2 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-black whitespace-nowrap transition-colors ${
            currentPath === '/old-results'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-old">Old Results</span>
        </a>
        <a
          href="/analytics"
          class={`hidden xl:inline-flex px-2 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-black whitespace-nowrap transition-colors ${
            currentPath === '/analytics'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-analytics">5Y Analytics</span>
        </a>
        <a
          href="/checker"
          class={`hidden 2xl:inline-flex px-2.5 xl:px-3.5 py-1.5 rounded-xl text-xs xl:text-sm font-black whitespace-nowrap transition-colors ${
            currentPath === '/checker'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-checker">Check Ticket</span>
        </a>
      </nav>

      {/* Controls: Notification Bell + WhatsApp Channel + Compact App Pill + Language Toggle */}
      <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
        <a
          href="https://whatsapp.com/channel/0029Vb9QMeoInlqLecSjJ927"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-black text-[11px] sm:text-xs px-2.5 sm:px-3 py-1.5 rounded-full shadow-xs active:scale-95 transition-all cursor-pointer leading-none border border-emerald-400/40"
          title="Join Dear Result Live WhatsApp Channel"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.14 15.86C14.16 16.73 14.57 16.56 15.02 16.52C15.46 16.47 16.46 15.92 16.67 15.33C16.87 14.75 16.87 14.25 16.81 14.15C16.75 14.05 16.59 13.99 16.35 13.87C16.1 13.75 14.91 13.16 14.69 13.08C14.47 13 14.31 12.96 14.15 13.2C13.99 13.45 13.52 14.01 13.38 14.17C13.24 14.33 13.1 14.35 12.86 14.23C12.61 14.11 11.82 13.85 10.88 13.01C10.15 12.36 9.66 11.55 9.52 11.31C9.38 11.07 9.5 10.94 9.62 10.82C9.73 10.71 9.87 10.53 10 10.38C10.12 10.22 10.16 10.1 10.24 9.94C10.32 9.78 10.28 9.64 10.22 9.52C10.16 9.4 9.69 8.24 9.49 7.77C9.3 7.3 9.1 7.37 8.95 7.36C8.81 7.35 8.67 7.33 8.53 7.33Z"/>
          </svg>
          <span class="hidden sm:inline text-white drop-shadow-2xs">WhatsApp</span>
        </a>

        <div id="header-bell-wrapper" class="header-notification-bell-wrapper flex items-center">
          <NotificationBell client:idle />
        </div>

        <button
          id="header-install-app-btn"
          type="button"
          onclick="window.triggerPwaInstall && window.triggerPwaInstall()"
          class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-[11px] sm:text-xs px-2 sm:px-2.5 py-1.5 rounded-lg sm:rounded-xl shadow-2xs border border-amber-300/80 active:scale-95 transition-all cursor-pointer leading-none"
          title="Install Dear Result Live App"
        >
          <span>📲</span>
          <span>App</span>
        </button>

        <LanguageToggle client:idle />
      </div>

    </div>
  </div>
</header>

<script is:inline>
  function applyHeaderLanguage(lang) {
    var brand = document.getElementById('header-brand-tagline');
    var navToday = document.getElementById('nav-today');
    var navLucky = document.getElementById('nav-lucky');
    var navYesterday = document.getElementById('nav-yesterday');
    var navTarget = document.getElementById('nav-target');
    var navOld = document.getElementById('nav-old');
    var navAnalytics = document.getElementById('nav-analytics');
    var navChecker = document.getElementById('nav-checker');

    if (lang === 'bn') {
      if (brand) brand.textContent = 'লটারি সংবাদ • লাইভ রেজাল্ট';
      if (navToday) navToday.textContent = 'আজকের';
      if (navLucky) navLucky.textContent = 'লাকি টিকিট';
      if (navYesterday) navYesterday.textContent = 'গতকালকের';
      if (navTarget) navTarget.textContent = 'টার্গেট নম্বর';
      if (navOld) navOld.textContent = 'পুরনো রেকর্ড';
      if (navAnalytics) navAnalytics.textContent = 'অ্যানালিটিক্স';
      if (navChecker) navChecker.textContent = 'টিকিট মেলান';
    } else if (lang === 'hi') {
      if (brand) brand.textContent = 'लॉटरी संबाद • लाइव रिजल्ट';
      if (navToday) navToday.textContent = 'आज का';
      if (navLucky) navLucky.textContent = 'लकी टिकट';
      if (navYesterday) navYesterday.textContent = 'कल का';
      if (navTarget) navTarget.textContent = 'टारगेट';
      if (navOld) navOld.textContent = 'पुराने रिकॉर्ड';
      if (navAnalytics) navAnalytics.textContent = 'एनालिटिक्स';
      if (navChecker) navChecker.textContent = 'टिकट चेक';
    } else {
      if (brand) brand.textContent = 'Lottery Sambad • Live Result Portal';
      if (navToday) navToday.textContent = "Today";
      if (navLucky) navLucky.textContent = "Lucky Ticket";
      if (navYesterday) navYesterday.textContent = "Yesterday";
      if (navTarget) navTarget.textContent = "Target Numbers";
      if (navOld) navOld.textContent = 'Old Results';
      if (navAnalytics) navAnalytics.textContent = '5Y Analytics';
      if (navChecker) navChecker.textContent = 'Check Ticket';
    }
  }

  try {
    var initialLang = localStorage.getItem('dearlottery_lang') || 'en';
    applyHeaderLanguage(initialLang);
  } catch(e) {}

  // If app is already installed and running as standalone PWA, hide install button
  try {
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator && window.navigator.standalone === true);
    if (isStandalone) {
      var appBtn = document.getElementById('header-install-app-btn');
      if (appBtn) appBtn.style.display = 'none';
    }
  } catch (e) {}

  window.triggerPwaInstall = async function() {
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator && window.navigator.standalone === true);
    if (isStandalone) {
      alert('Dear Result Live App is already installed on your device!');
      return;
    }

    if (window.deferredPwaPrompt) {
      try {
        window.deferredPwaPrompt.prompt();
        var choice = await window.deferredPwaPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          window.deferredPwaPrompt = null;
          var appBtn = document.getElementById('header-install-app-btn');
          if (appBtn) appBtn.style.display = 'none';
          var modal = document.getElementById('pwa-install-modal');
          if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }
          return;
        }
      } catch (err) {
        console.warn('Native PWA install prompt failed:', err);
      }
    }

    // Fallback: Open install guide modal immediately
    var modal = document.getElementById('pwa-install-modal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  };

  window.addEventListener('dearlottery:lang_change', function(e) {
    if (e.detail) {
      applyHeaderLanguage(e.detail);
    }
  });
</script>
