---
import LanguageToggle from './LanguageToggle';
import NotificationBell from './NotificationBell';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-1.5 sm:gap-4">
      
      {/* Brand Logo - Authentic Local Lottery Portal Identity */}
      <a href="/" class="flex items-center gap-2 sm:gap-3 group min-w-0 flex-shrink">
        <img
          src="/favicon.svg"
          alt="Dear Result Live"
          class="w-8 h-8 sm:w-11 sm:h-11 rounded-xl sm:rounded-2xl shadow-sm flex-shrink-0 group-hover:scale-105 transition-transform"
        />
        <div class="min-w-0">
          <div class="flex items-center gap-1 sm:gap-1.5">
            <span class="font-black text-xs sm:text-lg tracking-tight text-slate-900 group-hover:text-blue-700 transition-colors whitespace-nowrap">
              DEAR RESULT LIVE
            </span>
            <span class="bg-red-600 text-white font-black text-[8px] sm:text-[10px] px-1 sm:px-1.5 py-0.2 rounded-full uppercase tracking-wider animate-pulse shadow-2xs flex-shrink-0">
              LIVE
            </span>
          </div>
          <span id="header-brand-tagline" class="text-[9px] sm:text-[11px] text-blue-700 font-bold tracking-tight block truncate">
            Lottery Sambad • Live Result Portal
          </span>
        </div>
      </a>

      {/* Navigation Desktop */}
      <nav class="hidden md:flex items-center gap-1">
        <a
          href="/"
          class={`px-3 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-today">Today</span>
        </a>
        <a
          href="/lucky-ticket"
          class={`px-3 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/lucky-ticket' || currentPath === '/demo'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-lucky">Lucky Ticket</span>
        </a>
        <a
          href="/yesterday"
          class={`px-3 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/yesterday'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-yesterday">Yesterday</span>
        </a>
        <a
          href="/target-numbers"
          class={`px-3 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/target-numbers'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-target">Target & Hot</span>
        </a>
        <a
          href="/old-results"
          class={`px-3 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/old-results'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-old">Old Results</span>
        </a>
        <a
          href="/analytics"
          class={`px-3 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/analytics'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-analytics">5Y Analytics</span>
        </a>
        <a
          href="/checker"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/checker'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          <span id="nav-checker">Check Ticket</span>
        </a>
      </nav>

      {/* Controls: Notification Bell + Compact App Pill + Language Toggle + Desktop Checker */}
      <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
        <div id="header-bell-wrapper" class="header-notification-bell-wrapper flex items-center">
          <NotificationBell client:idle />
        </div>

        <button
          id="header-install-app-btn"
          type="button"
          onclick="window.triggerPwaInstall && window.triggerPwaInstall()"
          class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-[11px] sm:text-xs px-2 sm:px-2.5 py-1.5 rounded-lg sm:rounded-xl shadow-2xs border border-amber-300/80 active:scale-95 transition-all cursor-pointer leading-none"
          title="Install Dear Result Live App"
        >
          <span>📲</span>
          <span>App</span>
        </button>

        <a
          href="https://t.me/dearresultlive"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 bg-[#229ED9] hover:bg-[#1E88E5] text-white font-black text-[11px] sm:text-xs px-2 sm:px-2.5 py-1.5 rounded-lg sm:rounded-xl shadow-2xs active:scale-95 transition-all cursor-pointer leading-none"
          title="Join Dear Result Live Telegram Channel"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
          <span class="hidden sm:inline">Telegram</span>
        </a>

        <LanguageToggle client:idle />

        <a
          href="/checker"
          aria-label="Ticket Checker"
          class="hidden md:inline-flex items-center gap-1 bg-blue-700 hover:bg-blue-800 text-white text-[11px] sm:text-xs font-black px-2.5 sm:px-3 py-1.5 sm:py-2 rounded-lg sm:rounded-xl shadow-xs transition-all active:scale-95"
        >
          <span>🔍</span>
          <span id="header-btn-checker-full">Check Ticket</span>
        </a>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  function applyHeaderLanguage(lang) {
    var brand = document.getElementById('header-brand-tagline');
    var navToday = document.getElementById('nav-today');
    var navLucky = document.getElementById('nav-lucky');
    var navYesterday = document.getElementById('nav-yesterday');
    var navTarget = document.getElementById('nav-target');
    var navOld = document.getElementById('nav-old');
    var navChecker = document.getElementById('nav-checker');
    var btnFull = document.getElementById('header-btn-checker-full');
    var btnShort = document.getElementById('header-btn-checker-short');

    if (lang === 'bn') {
      if (brand) brand.textContent = 'লটারি সংবাদ • আজকের তাজা রেজাল্ট';
      if (navToday) navToday.textContent = 'আজকের রেজাল্ট';
      if (navLucky) navLucky.textContent = 'লাকি টিকিট';
      if (navYesterday) navYesterday.textContent = 'গতকালকের রেজাল্ট';
      if (navTarget) navTarget.textContent = 'টার্গেট ও হট নম্বর';
      if (navOld) navOld.textContent = 'পুরনো রেজাল্ট';
      if (navChecker) navChecker.textContent = 'টিকিট মেলান';
      if (btnFull) btnFull.textContent = 'টিকিট মেলান';
      if (btnShort) btnShort.textContent = 'মেলান';
    } else if (lang === 'hi') {
      if (brand) brand.textContent = 'लॉटरी संबाद • आज का ताजा रिजल्ट';
      if (navToday) navToday.textContent = 'आज का रिजल्ट';
      if (navLucky) navLucky.textContent = 'लकी टिकट';
      if (navYesterday) navYesterday.textContent = 'कल का रिजल्ट';
      if (navTarget) navTarget.textContent = 'टारगेट और हॉट नंबर';
      if (navOld) navOld.textContent = 'पुराने रिजल्ट';
      if (navChecker) navChecker.textContent = 'टिकट चेक';
      if (btnFull) btnFull.textContent = 'टिकट चेक';
      if (btnShort) btnShort.textContent = 'चेक';
    } else {
      if (brand) brand.textContent = 'Lottery Sambad • Live Result Portal';
      if (navToday) navToday.textContent = "Today";
      if (navLucky) navLucky.textContent = "Lucky Ticket";
      if (navYesterday) navYesterday.textContent = "Yesterday";
      if (navTarget) navTarget.textContent = "Target & Hot";
      if (navOld) navOld.textContent = 'Old Results';
      if (navChecker) navChecker.textContent = 'Check Ticket';
      if (btnFull) btnFull.textContent = 'Check Ticket';
      if (btnShort) btnShort.textContent = 'Check';
    }
  }

  try {
    var initialLang = localStorage.getItem('dearlottery_lang') || 'en';
    applyHeaderLanguage(initialLang);
  } catch(e) {}

  // If app is already installed and running as standalone PWA, hide install button
  try {
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator && window.navigator.standalone === true);
    if (isStandalone) {
      var appBtn = document.getElementById('header-install-app-btn');
      if (appBtn) appBtn.style.display = 'none';
    }
  } catch (e) {}

  window.triggerPwaInstall = async function() {
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator && window.navigator.standalone === true);
    if (isStandalone) {
      alert('Dear Result Live App is already installed on your device!');
      return;
    }

    if (window.deferredPwaPrompt) {
      try {
        window.deferredPwaPrompt.prompt();
        var choice = await window.deferredPwaPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          window.deferredPwaPrompt = null;
          var appBtn = document.getElementById('header-install-app-btn');
          if (appBtn) appBtn.style.display = 'none';
          var modal = document.getElementById('pwa-install-modal');
          if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }
          return;
        }
      } catch (err) {
        console.warn('Native PWA install prompt failed:', err);
      }
    }

    // Fallback: Open install guide modal immediately
    var modal = document.getElementById('pwa-install-modal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  };

  window.addEventListener('dearlottery:lang_change', function(e) {
    if (e.detail) {
      applyHeaderLanguage(e.detail);
    }
  });
</script>
