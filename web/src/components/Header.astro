---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      {/* Brand Logo */}
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform">
          ₹
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-black text-lg tracking-tight text-white group-hover:text-emerald-400 transition-colors">
              DEAR LOTTERY
            </span>
            <span class="bg-red-500/20 text-red-400 border border-red-500/30 text-[10px] font-bold px-1.5 py-0.2 rounded-full uppercase tracking-wider animate-pulse">
              LIVE
            </span>
          </div>
          <span class="text-[10px] text-slate-400 tracking-wider block font-mono">
            RESULT & ANALYTICS ENGINE
          </span>
        </div>
      </a>

      {/* Navigation Desktop */}
      <nav class="hidden md:flex items-center gap-1">
        <a
          href="/"
          class={`px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${
            currentPath === '/'
              ? 'text-emerald-400 bg-slate-900'
              : 'text-slate-300 hover:text-white hover:bg-slate-900/60'
          }`}
        >
          Today's Results
        </a>
        <a
          href="/checker"
          class={`px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${
            currentPath === '/checker'
              ? 'text-emerald-400 bg-slate-900'
              : 'text-slate-300 hover:text-white hover:bg-slate-900/60'
          }`}
        >
          Ticket Checker
        </a>
        <a
          href="/analytics"
          class={`px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${
            currentPath === '/analytics'
              ? 'text-emerald-400 bg-slate-900'
              : 'text-slate-300 hover:text-white hover:bg-slate-900/60'
          }`}
        >
          Hot & Cold Numbers
        </a>
      </nav>

      {/* CTA Button */}
      <div class="flex items-center gap-3">
        <a
          href="/checker"
          class="hidden sm:inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-xl shadow-md transition-all active:scale-95"
        >
          <span>🔍 Check Ticket</span>
        </a>
      </div>

    </div>
  </div>
</header>
