---
import LanguageToggle from './LanguageToggle';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-18">
      
      {/* Brand Logo - Authentic Local Lottery Portal Identity */}
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-tr from-amber-500 via-amber-400 to-yellow-500 flex items-center justify-center text-slate-950 font-black text-2xl shadow-md group-hover:scale-105 transition-transform">
          ₹
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-black text-base sm:text-lg tracking-tight text-slate-900 group-hover:text-blue-700 transition-colors">
              DEAR RESULT LIVE
            </span>
            <span class="bg-red-600 text-white font-black text-[9px] sm:text-[10px] px-1.5 py-0.2 rounded-full uppercase tracking-wider animate-pulse shadow-sm">
              LIVE
            </span>
          </div>
          <span class="text-[11px] text-blue-700 font-bold tracking-wide block">
            লটারি সংবাদ • আজকের তাজা রেজাল্ট
          </span>
        </div>
      </a>

      {/* Navigation Desktop */}
      <nav class="hidden md:flex items-center gap-1">
        <a
          href="/"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          আজকের রেজাল্ট
        </a>
        <a
          href="/old-results"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/old-results'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          পুরনো রেজাল্ট
        </a>
        <a
          href="/checker"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/checker'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          টিকিট মেলান
        </a>
        <a
          href="/analytics"
          class={`px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-colors ${
            currentPath === '/analytics'
              ? 'text-blue-700 bg-blue-50 border border-blue-200'
              : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100'
          }`}
        >
          হট নম্বর
        </a>
      </nav>

      {/* Controls: Language Toggle + CTA */}
      <div class="flex items-center gap-2 sm:gap-3">
        <LanguageToggle client:load />

        <a
          href="/checker"
          class="inline-flex items-center gap-1.5 bg-blue-700 hover:bg-blue-800 text-white text-xs font-black px-3.5 sm:px-4 py-2 rounded-xl shadow-sm transition-all active:scale-95"
        >
          <span>🔍</span>
          <span class="hidden sm:inline">টিকিট মেলান</span>
          <span class="sm:hidden">মেলান</span>
        </a>
      </div>

    </div>
  </div>
</header>
