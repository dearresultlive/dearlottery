---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  drawDate?: string;
  drawTime?: string;
  winningNumbers?: {
    firstPrize?: string;
    secondPrize?: string[];
  };
}

const {
  title = "Dear Lottery Result Today 1 PM 6 PM 8 PM Live | Lottery Sambad লটারি সংবাদ",
  description = "Check official Dear Lottery Sambad results today for 1:00 PM, 6:00 PM, and 8:00 PM draws live. Fast sub-300ms ticket checker, 1st prize ₹1 Crore winning numbers, and hot/cold number frequency.",
  canonicalUrl = Astro.url.href,
  drawDate = new Date().toISOString().slice(0, 10),
  drawTime,
  winningNumbers
} = Astro.props;

const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');
const host = Astro.url.origin.includes('localhost') ? Astro.url.origin : 'https://dearresultlive.in';
const cleanCanonical = canonicalUrl ? canonicalUrl.split('?')[0] : `${host}${cleanPath}`;

// Determine exact publication timestamp based on slot in IST (+05:30)
const pubHour = drawTime?.includes('6') ? '18:00:00+05:30' : drawTime?.includes('8') ? '20:00:00+05:30' : '13:00:00+05:30';

// 1. JSON-LD NewsArticle Schema
const lotterySchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "description": description,
  "datePublished": `${drawDate}T${pubHour}`,
  "dateModified": new Date().toISOString(),
  "mainEntityOfPage": cleanCanonical,
  "author": {
    "@type": "Organization",
    "name": "Dear Result Live",
    "url": "https://dearresultlive.in"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dear Result Live",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dearresultlive.in/favicon.svg"
    }
  }
};

// 2. JSON-LD WebSite & SearchAction Schema (Enables Google SERP Sitelinks Search Box)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Dear Result Live",
  "alternateName": ["Lottery Sambad", "ডিয়ার লটারি রেজাল্ট লাইভ", "Dear Lottery Result"],
  "url": "https://dearresultlive.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://dearresultlive.in/checker?number={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// 3. JSON-LD BreadcrumbList Schema (Clean SERP URL Hierarchy)
const pathSegments = currentPath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": `${host}/`
  }
];

let accumulatedPath = host;
pathSegments.forEach((segment, idx) => {
  accumulatedPath += `/${segment}`;
  const formattedName = segment.replace(/-/g, ' ').toUpperCase();
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": idx + 2,
    "name": formattedName,
    "item": accumulatedPath
  });
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

// 4. FAQ Schema for Rich Snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What time are Dear Lottery results published today?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dear Lottery draws are conducted three times daily at 1:00 PM (Morning), 6:00 PM (Day), and 8:00 PM (Evening/Night) under the authority of the Nagaland & Sikkim State Lotteries."
      }
    },
    {
      "@type": "Question",
      "name": "How much is the 1st prize in Dear Lottery Sambad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The first prize for Dear Lottery is ₹1 Crore (₹10,000,000) including super prize amount, awarded to the ticket matching the exact series (e.g., 84D) and 5-digit number."
      }
    },
    {
      "@type": "Question",
      "name": "How to check Dear Lottery ticket online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Visit https://dearresultlive.in/checker and enter your ticket number or just the last 4-5 digits to verify against 1st, 2nd, 3rd, 4th, 5th, and Consolation prizes instantly."
      }
    }
  ]
};

// 5. JSON-LD Table & Dataset Schema
const tableDatasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": `Dear Lottery Official Winning Numbers & Prize Table - ${drawDate} ${drawTime || ''}`.trim(),
  "description": `Structured prize breakdown table and winning numbers for Dear Lottery draws on ${drawDate}. Lists 1st Prize ₹1 Crore, Consolation Prize ₹1,000, 2nd Prize ₹10,000, 3rd Prize ₹500, 4th Prize ₹250, and 5th Prize ₹120.`,
  "url": cleanCanonical,
  "creator": {
    "@type": "Organization",
    "name": "Dear Result Live",
    "url": "https://dearresultlive.in"
  },
  "variableMeasured": [
    "1st Prize (₹1,00,00,000)",
    "Consolation Prize (₹1,00,000)",
    "2nd Prize (₹10,000)",
    "3rd Prize (₹500)",
    "4th Prize (₹250)",
    "5th Prize (₹120)"
  ],
  "mainEntity": {
    "@type": "Table",
    "about": `Prize Tier Distribution and Winning Ticket List for ${drawDate} ${drawTime || ''}`.trim(),
    "disambiguatingDescription": winningNumbers?.firstPrize
      ? `1st Prize winning ticket: ${winningNumbers.firstPrize}`
      : "Complete verified winning ticket distribution table."
  }
};

// 6. JSON-LD Speakable Specification Schema (Google Assistant & Voice Search Rich Answers)
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [
      "#status-title",
      ".first-prize-num",
      ".speakable-summary"
    ]
  },
  "url": cleanCanonical
};
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/pwa-192x192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/pwa-512x512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1d4ed8" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Dear Result" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="lottery sambad, লটারি সংবাদ, dear lottery result, dear lottery result today, nagaland state lottery, sikkim state lottery, dear lottery 1pm, dear lottery 6pm, dear lottery 8pm, dhankesari, dear lottery ticket checker, dear lottery live, dear lottery 1 crore winner" />
  
  <!-- Canonical & Multi-language Alternate URLs (Google Indexing Core) -->
  <link rel="canonical" href={cleanCanonical} />
  <link rel="alternate" hreflang="en-IN" href={cleanCanonical} />
  <link rel="alternate" hreflang="bn-IN" href={cleanCanonical} />
  <link rel="alternate" hreflang="hi-IN" href={cleanCanonical} />
  <link rel="alternate" hreflang="x-default" href={cleanCanonical} />

  <!-- Disable Google Chrome / Google Translate Popups -->
  <meta name="google" content="notranslate" />
  <!-- Search Engine Indexing Directives -->
  <meta name="robots" content="index, follow, notranslate, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, notranslate, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Google Search Console Site Verification -->
  <meta name="google-site-verification" content="rKu_zGhV7qZdRyslKFM2fD0TNttNYWJpqp-TNuM6CUA" />

  <!-- RSS Feed for Instant Googlebot Discovery -->
  <link rel="alternate" type="application/rss+xml" title="Dear Lottery Live Results Feed" href="https://dearresultlive.in/rss.xml" />

  <!-- OpenGraph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={cleanCanonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://dearresultlive.in/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Dear Result Live" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://dearresultlive.in/og-image.jpg" />

  <!-- High-Performance Asynchronous Web Fonts (Zero Render Blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" />
  </noscript>

  <!-- Google tag (gtag.js) - Asynchronous GA4 Tracking -->
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XK8RJKN6ZP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XK8RJKN6ZP', {
      page_path: window.location.pathname,
      send_page_view: true
    });
  </script>

  <!-- OneSignal Web Push SDK - Deferred to Idle Time for High Mobile PageSpeed -->
  <script is:inline>
    window.addEventListener('load', function() {
      function initOneSignal() {
        if (window._oneSignalInitialized) return;
        window._oneSignalInitialized = true;
        var s = document.createElement('script');
        s.src = "https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js";
        s.defer = true;
        document.head.appendChild(s);
        window.OneSignalDeferred = window.OneSignalDeferred || [];
        window.OneSignalDeferred.push(async function(OneSignal) {
          await OneSignal.init({
            appId: "7ede11f8-0188-4e67-88b0-d3947320982a",
            notifyButton: { enable: false },
            allowLocalhostAsSecureOrigin: true
          });
        });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initOneSignal, { timeout: 3000 });
      } else {
        setTimeout(initOneSignal, 2000);
      }
    });
  </script>

  <!-- Complete Structured Data Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(lotterySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(tableDatasetSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
</head>
